# GEMINI_API_KEY: Anlora AI (kart üretimi, anlam doğrulama, örnek cümle)
# uçlarının çalışması için gerekli. Tanımlı değilse uygulama çalışır, yalnızca
# yapay zekâ özellikleri devre dışı kalır ve arayüz bunu bildirir.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Uygulamanın yayınlandığı adres.
# Kendine yönelen bağlantılar ve API uçları için kullanılır.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: "Google ile giriş" için Google OAuth istemci kimliği.
# Sunucu, istemciden gelen kimlik jetonunu Google'da doğrular ve `aud`
# alanının bu değere eşit olmasını şart koşar. Tanımlı değilse Google ile
# giriş ucu 503 döner ve arayüz kullanıcıyı e-posta ile girişe yönlendirir.
GOOGLE_CLIENT_ID=""

# ANLORA_EXPOSE_DEV_CODE: "true" olduğunda e-posta doğrulama kodu HTTP
# yanıtında da döner. Yalnızca yerel geliştirme içindir; üretimde asla
# açılmamalıdır (NODE_ENV=production iken zaten yok sayılır).
ANLORA_EXPOSE_DEV_CODE="false"

# VITE_API_BASE_URL: Android (APK) derlemesi için sunucunun tam adresi.
# Web dağıtımında arayüz ve sunucu aynı kökendedir; bu değer boş bırakılır ve
# API çağrıları göreli "/api/..." yolunu kullanır. APK'da ise arayüz cihazdaki
# dosyalardan açıldığı için göreli yol sunucuya ulaşmaz; hesap, bulut yedeği
# ve Anlora AI'ın çalışması için buraya "https://ornek-alan-adi.com" gibi tam
# bir adres verilmelidir. Boş bırakılırsa uygulama yalnızca çevrimdışı
# çalışır: Oxford çekirdeği, kartlar ve ilerleme cihazda tutulduğu için
# etkilenmez.
VITE_API_BASE_URL=""

# ANLORA_ADMIN_EMAILS: Virgülle ayrılmış yönetici e-postaları. Tanımlı
# değilse yönetim panelinin tamamı kapalıdır ve uçları 404 döner. Rol
# veritabanında tutulmaz: veriyi ele geçiren biri kendini yönetici yapamasın.
# Boş bırakılırsa koddaki varsayılan yönetici (tahae2313@gmail.com) geçerli
# olur. Buraya bir değer yazıldığı anda varsayılan devre dışı kalır.
ANLORA_ADMIN_EMAILS=""

# RESEND_API_KEY / ANLORA_MAIL_FROM: E-posta gönderimi. Gönderen adresi
# Resend'de DOĞRULANMIŞ bir alan adına ait olmalı; doğrulanmamış alan adından
# çıkan posta reddedilir. Tanımlı değilse doğrulama kodları yalnızca sunucu
# günlüğüne yazılır ve kullanıcılar kodlarını alamaz.
RESEND_API_KEY=""
ANLORA_MAIL_FROM=""

# ANLORA_FCM_SERVICE_ACCOUNT: Firebase hizmet hesabı anahtarı. JSON metninin
# kendisi ya da dosya yolu olabilir. Tanımlı değilse anlık bildirim gönderimi
# kapalıdır; cihazlar yine kaydolur ve anahtar gelince gönderim yapılabilir.
ANLORA_FCM_SERVICE_ACCOUNT=""

# ANLORA_AI_DAILY_QUOTA / ANLORA_AI_USER_DAILY_QUOTA: Günlük yeni yapay zekâ
# üretim sınırı (varsayılan 200 / 25). Önbellekten gelen yanıtlar sayılmaz;
# kelime eklemek sınırsızdır.
ANLORA_AI_DAILY_QUOTA=""
ANLORA_AI_USER_DAILY_QUOTA=""

# ANLORA_DATA_DIR: Kullanıcı verisinin yazılacağı klasör. Varsayılan
# <çalışma dizini>/data. Barındırma hizmetinde kalıcı bir disk bağlıysa
# onun yolu verilmelidir, yoksa her dağıtımda veri silinir.
ANLORA_DATA_DIR=""
