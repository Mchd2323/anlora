[{"id":"gen-b2-zap","headword":"zap","cefr":"C1","sourceCollection":"extended","sourceOrder":2230,"sourceEntry":"zap n., v.","senses":[{"id":"gen-b2-zap-n","partOfSpeech":"n.","turkishMeanings":["ani darbe","elektrik çarpması","vınlama"],"examples":[{"en":"He felt a zap from the wire.","tr":"Kablodan bir çarpma hissetti."},{"en":"The machine gives a small zap.","tr":"Makine küçük bir çarpma veriyor."},{"en":"One zap and the bug was gone.","tr":"Bir vuruşta böcek yok oldu."}]},{"id":"gen-b2-zap-v","partOfSpeech":"v.","turkishMeanings":["vurmak","yok etmek","ışınlamak"],"examples":[{"en":"He zapped the mosquito.","tr":"Sivrisineği yok etti."},{"en":"She zapped the soup in the microwave.","tr":"Çorbayı mikrodalgada ısıttı."},{"en":"They zapped through the channels.","tr":"Kanalları hızla geçtiler."}]}],"variants":[],"phonetic":"/zæp/","band":2},{"id":"gen-b3-zeal","headword":"zeal","cefr":"C1","sourceCollection":"extended","sourceOrder":5744,"sourceEntry":"zeal n.","senses":[{"id":"gen-b3-zeal-n","partOfSpeech":"n.","turkishMeanings":["şevk","gayret"],"examples":[{"en":"He worked with great zeal.","tr":"Büyük bir şevkle çalıştı."},{"en":"Her zeal inspired the team.","tr":"Gayreti takıma ilham verdi."},{"en":"Too much zeal can be harmful.","tr":"Aşırı gayret zararlı olabilir."}]}],"variants":[],"phonetic":"/ziːl/","band":3},{"id":"gen-b2-zebra","headword":"zebra","cefr":"C1","sourceCollection":"extended","sourceOrder":2251,"sourceEntry":"zebra n.","senses":[{"id":"gen-b2-zebra-n","partOfSpeech":"n.","turkishMeanings":["zebra","çizgili yaban atı"],"examples":[{"en":"A zebra grazed near the water.","tr":"Bir zebra suyun yanında otladı."},{"en":"Every zebra has different stripes.","tr":"Her zebranın çizgileri farklıdır."},{"en":"The zebra ran from the lion.","tr":"Zebra aslandan kaçtı."}]}],"variants":[],"phonetic":"/ˈziːbɹə/","band":2},{"id":"gen-b3-zed","headword":"zed","cefr":"C1","sourceCollection":"extended","sourceOrder":4653,"sourceEntry":"zed n.","senses":[{"id":"g