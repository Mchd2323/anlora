id":"gen-b1-zoom","headword":"zoom","cefr":"C1","sourceCollection":"extended","sourceOrder":1008,"sourceEntry":"zoom n., v.","senses":[{"id":"gen-b1-zoom-n","partOfSpeech":"n.","turkishMeanings":["yakınlaştırma","vınlama"],"examples":[{"en":"The camera has a powerful zoom.","tr":"Kameranın güçlü bir yakınlaştırması var."},{"en":"We heard the zoom of a passing bike.","tr":"Geçen bir motorun vınlamasını duyduk."},{"en":"Use the zoom for distant shots.","tr":"Uzak çekimler için yakınlaştırmayı kullan."}]},{"id":"gen-b1-zoom-v","partOfSpeech":"v.","turkishMeanings":["hızla geçmek","yakınlaştırmak","fırlamak"],"examples":[{"en":"A car zoomed past the house.","tr":"Bir araba evin önünden hızla geçti."},{"en":"Zoom in to see the detail.","tr":"Ayrıntıyı görmek için yakınlaştır."},{"en":"Prices zoomed up last month.","tr":"Fiyatlar geçen ay fırladı."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b3-zucchini","headword":"zucchini","cefr":"C1","sourceCollection":"extended","sourceOrder":5678,"sourceEntry":"zucchini n.","senses":[{"id":"gen-b3-zucchini-n","partOfSpeech":"n.","turkishMeanings":["kabak","sakız kabağı"],"examples":[{"en":"She fried the zucchini.","tr":"Kabağı kızarttı."},{"en":"Zucchini grows fast in summer.","tr":"Kabak yazın hızlı büyür."},{"en":"Add zucchini to the pasta.","tr":"Makarnaya kabak ekle."}]}],"variants":[],"phonetic":"/zuːˈkiːniː/","band":3}]
