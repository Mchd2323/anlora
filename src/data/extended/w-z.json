[{"id":"gen-b2-zap","headword":"zap","cefr":"C1","sourceCollection":"extended","sourceOrder":2240,"sourceEntry":"zap n., v.","senses":[{"id":"gen-b2-zap-n","partOfSpeech":"n.","turkishMeanings":["ani darbe","elektrik çarpması","vınlama"],"examples":[{"en":"He felt a zap from the wire.","tr":"Kablodan bir çarpma hissetti."},{"en":"The machine gives a small zap.","tr":"Makine küçük bir çarpma veriyor."},{"en":"One zap and the bug was gone.","tr":"Bir vuruşta böcek yok oldu."}]},{"id":"gen-b2-zap-v","partOfSpeech":"v.","turkishMeanings":["vurmak","yok etmek","ışınlamak"],"examples":[{"en":"He zapped the mosquito.","tr":"Sivrisineği yok etti."},{"en":"She zapped the soup in the microwave.","tr":"Çorbayı mikrodalgada ısıttı."},{"en":"They zapped through the channels.","tr":"Kanalları hızla geçtiler."}]}],"variants":[],"phonetic":"/zæp/","band":2},{"id":"gen-b2-zebra","headword":"zebra","cefr":"C1","sourceCollection":"extended","sourceOrder":2261,"sourceEntry":"zebra n.","senses":[{"id":"gen-b2-zebra-n","partOfSpeech":"n.","turkishMeanings":["zebra","çizgili yaban atı"],"examples":[{"en":"A zebra grazed near the water.","tr":"Bir zebra suyun yanında otladı."},{"en":"Every zebra has different stripes.","tr":"Her zebranın çizgileri farklıdır."},{"en":"The zebra ran from the lion.","tr":"Zebra aslandan kaçtı."}]}],"variants":[],"phonetic":"/ˈziːbɹə/","band":2},{"id":"gen-b3-zed","headword":"zed","cefr":"C1","sourceCollection":"extended","sourceOrder":4665,"sourceEntry":"zed n.","senses":[{"id":"gen-b3-zed-n","partOfSpeech":"n.","turkishMeanings":["z harfi"],"examples":[{"en":"The word ends in a zed.","tr":"Sözcük z harfiyle bitiyor."},{"en":"British speakers say zed.","tr":"İngilizler zed der."},{"en":"He wrote a capital zed.","tr":"Büyük bir z harfi yazdı."}]}],"variants":[],"phonetic":"/zɛd/","band":3},{"id":"gen-b3-zee","headword":"zee","cefr":"C1","sourceCollection":"extended","sourceOrder":4516,"sourceEntry":"zee n.","senses":[{"id":"gen-b3-zee-n","partOfSpeech":"n.","turkishMeanings":["z harfi"],"examples":[{"en":"The word ends with a zee.","tr":"Sözcük z harfiyle bitiyor."},{"en":"He wrote a large zee.","tr":"Büyük bir z harfi yazdı."},{"en":"Americans say zee, not zed.","tr":"Amerikalılar zed değil zee der."}]}],"variants":[],"phonetic":"/ˈziː/","band":3},{"id":"gen-b3-zeta","headword":"zeta","cefr":"C1","sourceCollection":"extended","sourceOrder":4703,"sourceEntry":"zeta n.","senses":[{"id":"gen-b3-zeta-n","partOfSpeech":"n.","turkishMeanings":["zeta (Yunan harfi)"],"examples":[{"en":"The angle is marked zeta.","tr":"Açı zeta ile işaretlenmiş."},{"en":"Zeta follows epsilon.","tr":"Zeta epsilondan sonra gelir."},{"en":"He wrote zeta on the board.","tr":"Tahtaya zeta yazdı."}]}],"variants":[],"phonetic":"/ˈziː.tə/","band":3},{"id":"gen-b1-zip","headword":"zip","cefr":"C1","sourceCollection":"extended","sourceOrder":651,"sourceEntry":"zip n., v.","senses":[{"id":"gen-b1-zip-n","partOfSpeech":"n.","turkishMeanings":["fermuar","vınlama","hiç"],"examples":[{"en":"The zip on my bag is broken.","tr":"Çantamın fermuarı bozuk."},{"en":"She pulled the zip up slowly.","tr":"Fermuarı yavaşça yukarı çekti."},{"en":"He knows zip about cars.","tr":"Arabalar hakkında hiçbir şey bilmiyor."}]},{"id":"gen-b1-zip-v","partOfSpeech":"v.","turkishMeanings":["fermuarını çekmek","hızla gitmek","sıkıştırmak"],"examples":[{"en":"Zip your coat; it is cold.","tr":"Paltonun fermuarını çek, hava soğuk."},{"en":"The car zipped past the house.","tr":"Araba evin önünden hızla geçti."},{"en":"He zipped the files before sending.","tr":"Dosyaları göndermeden önce sıkıştırdı."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b2-zodiac","headword":"zodiac","cefr":"C1","sourceCollection":"extended","sourceOrder":2843,"sourceEntry":"zodiac n.","senses":[{"id":"gen-b2-zodiac-n","partOfSpeech":"n.","turkishMeanings":["burçlar kuşağı","zodyak"],"examples":[{"en":"The zodiac has twelve signs.","tr":"Burçlar kuşağında on iki burç vardır."},{"en":"She read about the zodiac.","tr":"Burçlar kuşağı hakkında okudu."},{"en":"The ceiling shows the zodiac.","tr":"Tavan burçlar kuşağını gösteriyor."}]}],"variants":[],"phonetic":"/ˈzəʊ.dɪ.æk/","band":2},{"id":"gen-b1-zombie","headword":"zombie","cefr":"C1","sourceCollection":"extended","sourceOrder":350,"sourceEntry":"zombie n.","senses":[{"id":"gen-b1-zombie-n","partOfSpeech":"n.","turkishMeanings":["zombi","yaşayan ölü"],"examples":[{"en":"The film is about a zombie attack.","tr":"Film bir zombi saldırısını anlatıyor."},{"en":"He walked around like a zombie.","tr":"Zombi gibi dolaştı."},{"en":"A zombie appeared in the doorway.","tr":"Kapı aralığında bir zombi belirdi."}]}],"variants":[],"phonetic":"/ˈzɒmbi/","band":1},{"id":"gen-b1-zoo","headword":"zoo","cefr":"C1","sourceCollection":"extended","sourceOrder":229,"sourceEntry":"zoo n.","senses":[{"id":"gen-b1-zoo-n","partOfSpeech":"n.","turkishMeanings":["hayvanat bahçesi"],"examples":[{"en":"We went to the zoo on Sunday.","tr":"Pazar günü hayvanat bahçesine gittik."},{"en":"The zoo has two young elephants.","tr":"Hayvanat bahçesinde iki genç fil var."},{"en":"The zoo closes at six.","tr":"Hayvanat bahçesi altıda kapanıyor."}]}],"variants":[],"phonetic":"/zuː/","band":1},{"id":"gen-b1-zoom","headword":"zoom","cefr":"C1","sourceCollection":"extended","sourceOrder":1012,"sourceEntry":"zoom n., v.","senses":[{"id":"gen-b1-zoom-n","partOfSpeech":"n.","turkishMeanings":["yakınlaştırma","vınlama"],"examples":[{"en":"The camera has a powerful zoom.","tr":"Kameranın güçlü bir yakınlaştırması var."},{"en":"We heard the zoom of a passing bike.","tr":"Geçen bir motorun vınlamasını duyduk."},{"en":"Use the zoom for distant shots.","tr":"Uzak çekimler için yakınlaştırmayı kullan."}]},{"id":"gen-b1-zoom-v","partOfSpeech":"v.","turkishMeanings":["hızla geçmek","yakınlaştırmak","fırlamak"],"examples":[{"en":"A car zoomed past the house.","tr":"Bir araba evin önünden hızla geçti."},{"en":"Zoom in to see the detail.","tr":"Ayrıntıyı görmek için yakınlaştır."},{"en":"Prices zoomed up last month.","tr":"Fiyatlar geçen ay fırladı."}]}],"variants":[],"phonetic":null,"band":1}]
