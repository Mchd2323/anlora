22,"sourceEntry":"kerosene n.","senses":[{"id":"gen-b3-kerosene-n","partOfSpeech":"n.","turkishMeanings":["gaz yağı","kerosen"],"examples":[{"en":"The lamp burns kerosene.","tr":"Lamba gaz yağı yakıyor."},{"en":"Kerosene smells strong.","tr":"Gaz yağı keskin kokar."},{"en":"They stored kerosene in a can.","tr":"Gaz yağını bir bidonda sakladılar."}]}],"variants":[],"phonetic":"/ˈkɛɹəsiːn/","band":3},{"id":"gen-b1-ketchup","headword":"ketchup","cefr":"C1","sourceCollection":"extended","sourceOrder":1273,"sourceEntry":"ketchup n.","senses":[{"id":"gen-b1-ketchup-n","partOfSpeech":"n.","turkishMeanings":["ketçap","domates sosu"],"examples":[{"en":"He put ketchup on his chips.","tr":"Patateslerine ketçap sürdü."},{"en":"The ketchup bottle was almost empty.","tr":"Ketçap şişesi neredeyse boştu."},{"en":"She never eats ketchup with eggs.","tr":"Yumurtayla asla ketçap yemez."}]}],"variants":[],"phonetic":"/ˈkɛtʃ.əp/","band":1},{"id":"gen-b1-kettle","headword":"kettle","cefr":"C1","sourceCollection":"extended","sourceOrder":1061,"sourceEntry":"kettle n.","senses":[{"id":"gen-b1-kettle-n","partOfSpeech":"n.","turkishMeanings":["çaydanlık","su ısıtıcısı"],"examples":[{"en":"Put the kettle on for tea.","tr":"Çay için çaydanlığı koy."},{"en":"The kettle boiled in two minutes.","tr":"Su ısıtıcısı iki dakikada kaynadı."},{"en":"Our kettle is broken again.","tr":"Su ısıtıcımız yine bozuldu."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b3-keypad","headword":"keypad","cefr":"C1","sourceCollection":"extended","sourceOrder":4149,"sourceEntry":"keypad n.","senses":[{"id":"gen-b3-keypad-n","partOfSpeech":"n.","turkishMeanings":["tuş takımı","tuş paneli"],"examples":[{"en":"Enter the code on the keypad.","tr":"Kodu tuş takımına gir."},{"en":"The keypad lights up at night.","tr":"Tuş takımı geceleri yanıyor."},{"en":"The keypad is broken.","tr":"Tuş takımı bozuk."}]}],"variants":[],"phonetic":"/ˈkiːpæd/","band":3},{"id":"gen-b3-kiddie","headword":"kiddie","cefr":"C1","sourceCollection":"extended","sourceOrder":4513,"sourceEntry":"kiddie n.","senses":[{"id":"gen-b3-kiddie-n","partOfSpeech":"n.","turkishMeanings":["çocukçuk","minik"],"examples":[{"en":"The kiddie pool is shallow.","tr":"Çocuk havuzu sığ."},{"en":"A kiddie ran past us.","tr":"Bir minik yanımızdan koştu."},{"en":"The show is for kiddies.","tr":"Gösteri çocuklar için."}]}],"variants":[],"phonetic":"/ˈkɪd.i/","band":3},{"id":"gen-b1-kilo","headword":"kilo","cefr":"C1","sourceCollection":"extended","sourceOrder":1625,"sourceEntry":"kilo n.","senses":[{"id":"gen-b1-kilo-n","partOfSpeech":"n.","turkishMeanings":["kilo","kilogram"],"examples":[{"en":"Buy two kilos of apples.","tr":"İki kilo elma al."},{"en":"The bag weighs five kilos.","tr":"Çanta beş kilo geliyor."},{"en":"She lost three kilos this month.","tr":"Bu ay üç kilo verdi."}]}],"variants":[],"phonetic":"/ˈkiːləʊ/","band":1},{"id":"gen-b2-kimono","headword":"kimono","cefr":"C1","sourceCollection":"extended","sourceOrder":3384,"sourceEntry":"kimono n.","senses":[{"id":"gen-b2-kimono-n","partOfSpeech":"n.","turkishMeanings":["kimono","geleneksel Japon giysisi"],"examples":[{"en":"She wore a silk kimono.","tr":"İpek bir kimono giymişti."},{"en":"The kimono has wide sleeves.","tr":"Kimononun geniş kolları var."},{"en":"He bought a kimono in Kyoto.","tr":"Kyoto'da bir kimono aldı."}]}],"variants":[],"phonetic":"/kəˈmoʊnoʊ/","band":2},{"id":"gen-b1-kindergarten","headword":"kindergarten","cefr":"C1","sourceCollection":"extended","sourceOrder":1227,"sourceEntry":"kindergarten n.","senses":[{"id":"gen-b1-kindergarten-n","partOfSpeech":"n.","turkishMeanings":["anaokulu","kreş"],"examples":[{"en":"Her son starts kindergarten this year.","tr":"Oğlu bu yıl anaokuluna başlıyor."},{"en":"The kindergarten opens at eight.","tr":"Anaokulu sekizde açılıyor."},{"en":"He teaches at a small kindergarten.","tr":"Küçük bir anaokulunda öğretmenlik yapıyor."}]}],"variants":[],"phonetic":"/ˈkɪndəɹˌɡɑːɹt(ə)n/","band":1},{"id":"gen-b1-kindness","headword":"kindness","cefr":"C1","sourceCollection":"extended","sourceOrder":327,"sourceEntry":"kindness n.","senses":[{"id":"gen-b1-kindness-n","partOfSpeech":"n.","turkishMeanings":["nezaket","iyilik","şefkat"],"examples":[{"en":"Thank you for your kindness.","tr":"Nezaketiniz için teşekkür ederim."},{"en":"She showed great kindness to strangers.","tr":"Yabancılara büyük bir iyilik gösterdi."},{"en":"A small kindness can mean a lot.","tr":"Küçük bir iyilik çok şey ifade edebilir."}]}],"variants":[],"phonetic":"/ˈkaɪndnɪs/","band":1},{"id":"gen-b2-kinky","headword":"kinky","cefr":"C1","sourceCollection":"extended","sourceOrder":2357,"sourceEntry":"kinky adj.","senses":[{"id":"gen-b2-kinky-adj","partOfSpeech":"adj.","turkishMeanings":["kıvır kıvır","tuhaf","sıra dışı"],"examples":[{"en":"Her hair is thick and kinky.","tr":"Saçı gür ve kıvır kıvır."},{"en":"The wire got kinky in the box.","tr":"Tel kutuda kıvrıldı."},{"en":"He has kinky taste in furniture.","tr":"Mobilyada sıra dışı bir zevki var."}]}],"variants":[],"phonetic":"/ˈkɪŋ.ki/","band":2},{"id":"gen-b1-kite","headword":"kite","cefr":"C1","sourceCollection":"extended","sourceOrder":1261,"sourceEntry":"kite n., v.","senses":[{"id":"gen-b1-kite-n","partOfSpeech":"n.","turkishMeanings":["uçurtma","çaylak"],"examples":[{"en":"The children flew a kite on the hill.","tr":"Çocuklar tepede uçurtma uçurdu."},{"en":"The kite got stuck in a tree.","tr":"Uçurtma bir ağaca takıldı."},{"en":"A kite circled above the field.","tr":"Bir çaylak tarlanın üstünde daire çizdi."}]},{"id":"gen-b1-kite-v","partOfSpeech":"v.","turkishMeanings":["karşılıksız çek vermek","süzülmek"],"examples":[{"en":"He kited cheques for months.","tr":"Aylarca karşılıksız çek verdi."},{"en":"The bird kited on the warm air.","tr":"Kuş sıcak havada süzüldü."},{"en":"She kited a cheque to pay the rent.","tr":"Kirayı ödemek için karşılıksız çek verdi."}]}],"variants":[],"phonetic":"/kaɪt/","band":1},{"id":"gen-b1-kitten","headword":"kitten","cefr":"C1","sour