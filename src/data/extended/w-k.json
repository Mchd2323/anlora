nd warm.","tr":"Örgü yumuşak ve sıcak."},{"en":"This knit needs washing by hand.","tr":"Bu örgü elde yıkanmalı."}]},{"id":"gen-b2-knit-v","partOfSpeech":"v.","turkishMeanings":["örmek","kaynamak","birleştirmek"],"examples":[{"en":"She knits every evening.","tr":"Her akşam örgü örüyor."},{"en":"The broken bone knit slowly.","tr":"Kırık kemik yavaş kaynadı."},{"en":"He knit his brows in thought.","tr":"Düşünürken kaşlarını çattı."}]}],"variants":[],"phonetic":"/ˈnɪt/","band":2},{"id":"gen-b2-knitting","headword":"knitting","cefr":"C1","sourceCollection":"extended","sourceOrder":2363,"sourceEntry":"knitting n.","senses":[{"id":"gen-b2-knitting-n","partOfSpeech":"n.","turkishMeanings":["örgü","örgü örme"],"examples":[{"en":"She picked up her knitting.","tr":"Örgüsünü eline aldı."},{"en":"Knitting relaxes him.","tr":"Örgü örmek onu rahatlatıyor."},{"en":"The knitting lay on the chair.","tr":"Örgü sandalyede duruyordu."}]}],"variants":[],"phonetic":"/ˈnɪtɪŋ/","band":2},{"id":"gen-b1-knob","headword":"knob","cefr":"C1","sourceCollection":"extended","sourceOrder":1864,"sourceEntry":"knob n.","senses":[{"id":"gen-b1-knob-n","partOfSpeech":"n.","turkishMeanings":["tokmak","topuz","düğme"],"examples":[{"en":"Turn the knob to the right.","tr":"Düğmeyi sağa çevir."},{"en":"The door knob came off.","tr":"Kapı tokmağı çıktı."},{"en":"Add a knob of butter.","tr":"Bir parça tereyağı ekle."}]}],"variants":[],"phonetic":"/nɒb/","band":1},{"id":"gen-b1-knockout","headword":"knockout","cefr":"C1","sourceCollection":"extended","sourceOrder":1769,"sourceEntry":"knockout adj., n.","senses":[{"id":"gen-b1-knockout-adj","partOfSpeech":"adj.","turkishMeanings":["nakavt eden","eleme usulü","çarpıcı"],"examples":[{"en":"It was a knockout punch.","tr":"Nakavt eden bir yumruktu."},{"en":"The knockout stage begins tomorrow.","tr":"Eleme aşaması yarın başlıyor."},{"en":"She wore a knockout dress.","tr":"Çarpıcı bir elbise giymişti."}]},{"id":"gen-b1-knockout-n","partOfSpeech":"n.","turkishMeanings"