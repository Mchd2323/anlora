[{"id":"gen-b1-yacht","headword":"yacht","cefr":"C1","sourceCollection":"extended","sourceOrder":685,"sourceEntry":"yacht n., v.","senses":[{"id":"gen-b1-yacht-n","partOfSpeech":"n.","turkishMeanings":["yat","gezinti teknesi"],"examples":[{"en":"The yacht anchored in the bay.","tr":"Yat koyda demirledi."},{"en":"They sailed the yacht to the island.","tr":"Yatla adaya yelken açtılar."},{"en":"A white yacht passed the harbour.","tr":"Beyaz bir yat limandan geçti."}]},{"id":"gen-b1-yacht-v","partOfSpeech":"v.","turkishMeanings":["yatla gezmek","yat yarışına katılmak"],"examples":[{"en":"They yacht around the islands each June.","tr":"Her haziran adalar arasında yatla geziyorlar."},{"en":"He yachted along the southern coast.","tr":"Güney kıyısı boyunca yatla gezdi."},{"en":"She yachts every summer with friends.","tr":"Her yaz arkadaşlarıyla yatla geziyor."}]}],"variants":[],"phonetic":"/jɒt/","band":1},{"id":"gen-b10-yachtsman","headword":"yachtsman","cefr":"C1","sourceCollection":"extended","sourceOrder":19720,"sourceEntry":"yachtsman n.","senses":[{"id":"gen-b10-yachtsman-n","partOfSpeech":"n.","turkishMeanings":["yatçı","yat sahibi ya da yat kullanan kimse"],"examples":[{"en":"The yachtsman crossed the bay alone.","tr":"Yatçı körfezi tek başına geçti."},{"en":"A yachtsman must read the weather.","tr":"Bir yatçı havayı okumalıdır."},{"en":"The yachtsman won the race twice.","tr":"Yatçı yarışı iki kez kazandı."}]}],"variants":[],"phonetic":null,"band":10},{"id":"gen-b8-yack","headword":"yack","cefr":"C1","sourceCollection":"extended","sourceOrder":15997,"sourceEntry":"yack n., v.","senses":[{"id":"gen-b8-yack-n","partOfSpeech":"n.","turkishMeanings":["gevezelik","boş laf"],"examples":[{"en":"I am tired of all this yack.","tr":"Bu gevezelikten bıktım."},{"en":"The yack went on for hours.","tr":"Boş laf saatlerce sürdü."},{"en":"Behind the door there was constant yack.","tr":"Kapının ardında aralıksız gevezelik vardı."}]},{"id":"gen-b8-yack-v","partOfSpeech":"v.","turkis