he lecture.","tr":"Ders boyunca esnedi."},{"en":"A gap yawned before them.","tr":"Önlerinde bir boşluk açıldı."},{"en":"She yawned and stretched.","tr":"Esnedi ve gerindi."}]}],"variants":[],"phonetic":"/jɔːn/","band":3},{"id":"gen-b2-yawning","headword":"yawning","cefr":"C1","sourceCollection":"extended","sourceOrder":3539,"sourceEntry":"yawning adj., n.","senses":[{"id":"gen-b2-yawning-adj","partOfSpeech":"adj.","turkishMeanings":["esneyen","kocaman açık","uçsuz"],"examples":[{"en":"A yawning gap opened in the wall.","tr":"Duvarda kocaman bir boşluk açıldı."},{"en":"The yawning student left early.","tr":"Esneyen öğrenci erken çıktı."},{"en":"There is a yawning difference between them.","tr":"Aralarında uçurum gibi bir fark var."}]},{"id":"gen-b2-yawning-n","partOfSpeech":"n.","turkishMeanings":["esneme"],"examples":[{"en":"His yawning annoyed the teacher.","tr":"Esnemesi öğretmeni rahatsız etti."},{"en":"Yawning is often contagious.","tr":"Esneme çoğu zaman bulaşıcıdır."},{"en":"The yawning stopped after coffee.","tr":"Kahveden sonra esneme durdu."}]}],"variants":[],"phonetic":null,"band":2},{"id":"gen-b12-yawp","headword":"yawp","cefr":"C1","sourceCollection":"extended","sourceOrder":23379,"sourceEntry":"yawp v.","senses":[{"id":"gen-b12-yawp-v","partOfSpeech":"v.","turkishMeanings":["bağırıp çağırmak","sızlanarak yakınmak"],"examples":[{"en":"The gulls yawp over the harbour.","tr":"Martılar limanın üstünde bağırıp çağırıyor."},{"en":"He began to yawp about the rent.","tr":"Kira konusunda sızlanmaya başladı."},{"en":"They yawped until someone listened.","tr":"Biri dinleyene dek bağırıp çağırdılar."}]}],"variants":[],"phonetic":null,"band":12},{"id":"gen-b1-yea","headword":"yea","cefr":"C1","sourceCollection":"extended","sourceOrder":514,"sourceEntry":"yea adv., n.","senses":[{"id":"gen-b1-yea-adv","partOfSpeech":"adv.","turkishMeanings":["evet","hatta","gerçekten"],"examples":[{"en":"Yea, it shall be done.","tr":"Evet, bu yapılacak."},{"en":"He was brave, yea, fearless.","tr":"Cesurdu, hatta korkusuzdu."},{"en":"Yea, the words were true.","tr":"Gerçekten, sözler doğruydu."}]},{"id":"gen-b1-yea-n","partOfSpeech":"n.","turkishMeanings":["kabul oyu","evet oyu"],"examples":[{"en":"The motion passed with thirty yeas.","tr":"Önerge otuz kabul oyuyla geçti."},{"en":"Count the yeas and the nays.","tr":"Kabul ve ret oylarını say."},{"en":"His yea decided the vote.","tr":"Onun evet oyu oylamayı belirledi."}]}],"variants":[],"phonetic":"/jeɪ/","band":1},{"id":"gen-b2-yearbook","headword":"yearbook","cefr":"C1","sourceCollection":"extended","sourceOrder":2405,"sourceEntry":"yearbook n.","senses":[{"id":"gen-b2-yearbook-n","partOfSpeech":"n.","turkishMeanings":["yıllık","mezuniyet albümü"],"examples":[{"en":"She signed my yearbook.","tr":"Yıllığımı imzaladı."},{"en":"The yearbook has every class photo.","tr":"Yıllıkta her sınıfın fotoğrafı var."},{"en":"He kept the yearbook for years.","tr":"Yıllığı yıllarca sakladı."}]}],"variants":[],"phonetic":null,"band":2},{"id":"gen-b8-yearling","headword":"yearling","cefr":"C1","sourceCollection":"extended","sourceOrder":15169,"sourceEntry":"yearling n.","senses":[{"id":"gen-b8-yearling-n","partOfSpeech":"n.","turkishMeanings":["bir yaşındaki çocuk","bir yaşındaki yarış atı","bir yaşını doldurmuş hayvan"],"examples":[{"en":"The proud parents watched their little yearling take his first steps.","tr":"Gururlu ebeveynler küçük bir yaşındaki çocuklarının ilk adımlarını atmasını izlediler."},{"en":"The trainer prepared the yearling for the upcoming spring races.","tr":"Antrenör, bir yaşındaki yarış atını yaklaşan ilkbahar yarışlarına hazırladı."},{"en":"They moved the yearling to a separate pasture with the older cattle.","tr":"Bir yaşındaki hayvanı daha yaşlı sığırlarla birlikte ayrı bir otlağa taşıdılar."}]}],"variants":[],"phonetic":null,"band":8},{"id":"gen-b11-yearlong","headword":"yearlong","cefr":"C1","sourceCollection":"extended","sourceOrder":21958,"sourceEntry":"yearlong adj.","senses":[{"id