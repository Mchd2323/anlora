":"The dog gave a sharp yap.","tr":"Köpek keskin bir havlama çıkardı."},{"en":"A yap came from the hall.","tr":"Koridordan bir havlama geldi."},{"en":"Enough of that yap.","tr":"Bu gevezelik yeter."}]},{"id":"gen-b3-yap-v","partOfSpeech":"v.","turkishMeanings":["kısa kısa havlamak","gevezelik etmek"],"examples":[{"en":"The little dog yapped at us.","tr":"Küçük köpek bize havladı."},{"en":"He yapped on for an hour.","tr":"Bir saat gevezelik etti."},{"en":"The puppy yapped all night.","tr":"Yavru köpek bütün gece havladı."}]}],"variants":[],"phonetic":"/jæp/","band":3},{"id":"gen-b10-yardage","headword":"yardage","cefr":"C1","sourceCollection":"extended","sourceOrder":18438,"sourceEntry":"yardage n.","senses":[{"id":"gen-b10-yardage-n","partOfSpeech":"n.","turkishMeanings":["yarda cinsinden uzunluk","kumaş metrajı"],"examples":[{"en":"Measure the yardage before cutting.","tr":"Kesmeden önce metrajı ölç."},{"en":"He gained good yardage on that play.","tr":"O oyunda iyi bir mesafe kazandı."},{"en":"The yardage of the course is posted.","tr":"Sahanın yarda uzunluğu ilan edilmiş."}]}],"variants":[],"phonetic":null,"band":10},{"id":"gen-b8-yardarm","headword":"yardarm","cefr":"C1","sourceCollection":"extended","sourceOrder":14196,"sourceEntry":"yardarm n.","senses":[{"id":"gen-b8-yardarm-n","partOfSpeech":"n.","turkishMeanings":["seren ucu","yelkenli direğindeki yatay direğin ucu"],"examples":[{"en":"A lantern hung from the yardarm.","tr":"Seren ucundan bir fener sarkıyordu."},{"en":"The rope ran to the yardarm.","tr":"Halat seren ucuna gidiyordu."},{"en":"He climbed out to the yardarm.","tr":"Seren ucuna kadar tırmandı."}]}],"variants":[],"phonetic":null,"band":8},{"id":"gen-b12-yardbird","headword":"yardbird","cefr":"C1","sourceCollection":"extended","sourceOrder":23178,"sourceEntry":"yardbird n.","senses":[{"id":"gen-b12-yardbird-n","partOfSpeech":"n.","turkishMeanings":["angarya eri","hükümlü","acemi asker"],"examples":[{"en":"The yardbird peeled potatoes all day.","tr":"Angarya eri bütün gün patates soydu."},{"en":"Every yardbird gets the worst jobs.","tr":"Her angarya erine en kötü işler düşer."},{"en":"He was a yardbird for six months.","tr":"Altı ay angarya eri oldu."}]}],"variants":[],"phonetic":"/ˈjɑːd.bəːd/","band":12},{"id":"gen-b13-yardie","headword":"yardie","cefr":"C1","sourceCollection":"extended","sourceOrder":24288,"sourceEntry":"yardie n.","senses":[{"id":"gen-b13-yardie-n","partOfSpeech":"n.","turkishMeanings":["yardie","Jamaika kökenli suç örgütü üyesi"],"examples":[{"en":"The police linked the shooting to a yardie gang.","tr":"Polis silahlı saldırıyı bir yardie çetesine bağladı."},{"en":"The term yardie names a criminal group, not a people.","tr":"Bu terim bir halkı değil bir suç grubunu adlandırır."},{"en":"A yardie was arrested at the port.","tr":"Limanda bir yardie tutuklandı."}]}],"variants":[],"phonetic":null,"band":13},{"id":"gen-b12-yardman","headword":"yardman","cefr":"C1","sourceCollection":"extended","sourceOrder":23748,"sourceEntry":"yardman n.","senses":[{"id":"gen-b12-yardman-n","partOfSpeech":"n.","turkishMeanings":["gar işçisi","bahçe işlerinde çalışan işçi"],"examples":[{"en":"The yardman coupled the wagons.","tr":"Gar işçisi vagonları bağladı."},{"en":"A yardman mows the lawn each week.","tr":"Bir bahçe işçisi çimi her hafta biçer."},{"en":"The yardman signalled with a lamp.","tr":"Gar işçisi bir lambayla işaret verdi."}]}],"variants":[],"phonetic":"/ˈjɑɹdmən/","band":12},{"id":"gen-b12-yardmaster","headword":"yardmaster","cefr":"C1","sourceCollection":"extended","sourceOrder":23163,"sourceEntry":"yardmaster n.","senses":[{"id":"gen-b12-yardmaster-n","partOfSpeech":"n.","turkishMeanings":["manevra şefi","tren garı sorumlusu"],"examples":[{"en":"The yardmaster ordered the shunt.","tr":"Manevra şefi manevrayı emretti."},{"en":"A yardmaster watches every track.","tr":"Manevra şefi her hattı gözler."},{"en":"He was promoted to yardmaster.","tr":"Manevra şefliğine yükseltildi."}]}],"variants":[],"phonetic":null,"band":12},{"id":"gen-b7-yardstick","headword":"yardstick","cefr":"C1","sourceCollection":"extended","sourceOrder":13820,"sourceEntry":"yardstick n.","senses":[{"id":"gen-b7-yardstick-n","partOfSpeech":"n.","turkishMeanings":["ölçüt","karşılaştırma için kullanılan standart"],"examples":[{"en":"Profit is not the only yardstick.","tr":"Kâr tek ölçüt değildir."},{"en":"They use last year as a yardstick.","tr":"Geçen yılı ölçüt olarak kullanıyorlar."},{"en":"By any yardstick, it worked.","tr":"Hangi ölçütle bakılsa işe yaradı."}]}],"variants":[],"phonetic":null,"band":7},{"id":"gen-b7-yarmulke","headword":"yarmulke","cefr":"C1","sourceCollection":"extended","sourceOrder":12615,"sourceEntry":"yarmulke n.","senses":[{"id":"gen-b7-yarmulke-n","partOfSpeech":"n.","turkishMeanings":["kipa","başın tepesine takılan küçük takke"],"examples":[{"en":"He wore a black yarmulke.","tr":"Siyah bir kipa takmıştı."},{"en":"The yarmulke slipped off.","tr":"Kipa kaydı."},{"en":"A guest borrowed a yarmulke.","tr":"Bir konuk kipa ödünç aldı."}]}],"variants":[],"phonetic":"/ˈjɑːməlkə/","band":7},{"id":"gen-b2-yarn","headword":"yarn","cefr":"C1","sourceCollection":"extended","sourceOrder":3671,"sourceEntry":"yarn n., v.","senses":[{"id":"gen-b2-yarn-n","partOfSpeech":"n.","turkishMeanings":["iplik","yün","uzun hikâye"],"examples":[{"en":"She bought red yarn.","tr":"Kırmızı iplik aldı."},{"en":"The yarn is soft wool.","tr":"İplik yumuşak yündür."},{"en":"He told us a long yarn.","tr":"Bize uzun bir hikâye anlattı."}]},{"id":"gen-b2-yarn-v","partOfSpeech":"v.","turkishMeanings":["hikâye anlatmak","sohbet etmek"],"examples":[{"en":"They yarned late into the night.","tr":"Gece geç saatlere kadar sohbet ettiler."},{"en":"The old sailor yarned about storms.","tr":"Yaşlı denizci fırtına hikâyeleri anlattı."},{"en":"We yarned by the fire.","tr":"Ateşin yanında sohbet ettik."}]}],"variants":[],"phonetic":"/jɑːn/","band":2},{"id":"gen-b8-yarrow","headword":"yarrow","cefr":"C1","sourceCollec