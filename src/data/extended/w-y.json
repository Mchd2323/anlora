.","senses":[{"id":"gen-b12-yeasty-adj","partOfSpeech":"adj.","turkishMeanings":["mayamsı","coşkulu","kabaran"],"examples":[{"en":"The bread has a yeasty smell.","tr":"Ekmeğin mayamsı bir kokusu var."},{"en":"A yeasty excitement filled the hall.","tr":"Salonu coşkulu bir heyecan doldurdu."},{"en":"The decade was yeasty and creative.","tr":"O on yıl coşkulu ve yaratıcıydı."}]}],"variants":[],"phonetic":"/ˈjiːsti/","band":12},{"id":"gen-b10-yellowcake","headword":"yellowcake","cefr":"C1","sourceCollection":"extended","sourceOrder":19734,"sourceEntry":"yellowcake n.","senses":[{"id":"gen-b10-yellowcake-n","partOfSpeech":"n.","turkishMeanings":["sarı pasta","işlenmiş uranyum oksit tozu"],"examples":[{"en":"Yellowcake is an early stage of processing.","tr":"Sarı pasta işlemenin erken bir aşamasıdır."},{"en":"They shipped yellowcake in sealed drums.","tr":"Sarı pastayı mühürlü fıçılarla gönderdiler."},{"en":"Yellowcake is not yet fuel.","tr":"Sarı pasta henüz yakıt değildir."}]}],"variants":[],"phonetic":null,"band":10},{"id":"gen-b11-yellowfin","headword":"yellowfin","cefr":"C1","sourceCollection":"extended","sourceOrder":20386,"sourceEntry":"yellowfin n.","senses":[{"id":"gen-b11-yellowfin-n","partOfSpeech":"n.","turkishMeanings":["sarı kanat orkinos","sarı yüzgeçli ton balığı"],"examples":[{"en":"They caught a huge yellowfin.","tr":"Kocaman bir sarı kanat orkinos yakaladılar."},{"en":"Yellowfin live in warm seas.","tr":"Sarı kanat orkinoslar sıcak denizlerde yaşar."},{"en":"The yellowfin can weigh hundreds of pounds.","tr":"Bu balık yüzlerce kilo çekebilir."}]}],"variants":[],"phonetic":null,"band":11},{"id":"gen-b8-yellowish","headword":"yellowish","cefr":"C1","sourceCollection":"extended","sourceOrder":14280,"sourceEntry":"yellowish adj.","senses":[{"id":"gen-b8-yellowish-adj","partOfSpeech":"adj.","turkishMeanings":["sarımsı","sarıya çalan"],"examples":[{"en":"The paper turned yellowish.","tr":"Kâğıt sarımsı oldu."},{"en":"A yellowish light filled the room.","tr":"O