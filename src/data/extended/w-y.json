","partOfSpeech":"adj.","turkishMeanings":["nefis","çok lezzetli","mis gibi"],"examples":[{"en":"The cake smells yummy.","tr":"Kek nefis kokuyor."},{"en":"That was a yummy dinner.","tr":"Çok lezzetli bir akşam yemeğiydi."},{"en":"The children said the soup was yummy.","tr":"Çocuklar çorbanın nefis olduğunu söyledi."}]}],"variants":[],"phonetic":"/ˈjʌm.i/","band":1},{"id":"gen-b5-yuppie","headword":"yuppie","cefr":"C1","sourceCollection":"extended","sourceOrder":8710,"sourceEntry":"yuppie n.","senses":[{"id":"gen-b5-yuppie-n","partOfSpeech":"n.","turkishMeanings":["genç kentli profesyonel","kariyerine düşkün genç kentli"],"examples":[{"en":"The bar was full of yuppie types.","tr":"Bar genç kentli profesyonellerle doluydu."},{"en":"He was called a yuppie in the eighties.","tr":"Seksenlerde ona genç kentli profesyonel dediler."},{"en":"A yuppie bought the old flat.","tr":"Eski daireyi genç bir kentli profesyonel aldı."}]}],"variants":[],"phonetic":"/ˈjʌpɪ/","band":5},{"id":"gen-b6-yurt","headword":"yurt","cefr":"C1","sourceCollection":"extended","sourceOrder":11662,"sourceEntry":"yurt n.","senses":[{"id":"gen-b6-yurt-n","partOfSpeech":"n.","turkishMeanings":["yurt çadırı","keçeyle örtülü göçebe çadırı"],"examples":[{"en":"They slept in a yurt.","tr":"Bir yurt çadırında uyudular."},{"en":"The yurt is warm inside.","tr":"Çadırın içi sıcak."},{"en":"A yurt can be moved in a day.","tr":"Bir yurt çadırı bir günde taşınabilir."}]}],"variants":[],"phonetic":"/jɜːt/","band":6},{"id":"gen-b11-yus","headword":"yus","cefr":"C1","sourceCollection":"extended","sourceOrder":21483,"sourceEntry":"yus n.","senses":[{"id":"gen-b11-yus-n","partOfSpeech":"n.","turkishMeanings":["yus","eski Kiril alfabesinde genizsil ünlü harfi"],"examples":[{"en":"The old text uses a yus here.","tr":"Eski metin burada bir yus harfi kullanıyor."},{"en":"A yus marked a nasal vowel.","tr":"Yus harfi genizsil bir ünlüyü gösterirdi."},{"en":"The yus dropped out of use.","tr":"Yus harfi kullanımdan kalktı."}]}]