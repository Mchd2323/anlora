[{"id":"gen-b1-yacht","headword":"yacht","cefr":"C1","sourceCollection":"extended","sourceOrder":686,"sourceEntry":"yacht n., v.","senses":[{"id":"gen-b1-yacht-n","partOfSpeech":"n.","turkishMeanings":["yat","gezinti teknesi"],"examples":[{"en":"The yacht anchored in the bay.","tr":"Yat koyda demirledi."},{"en":"They sailed the yacht to the island.","tr":"Yatla adaya yelken açtılar."},{"en":"A white yacht passed the harbour.","tr":"Beyaz bir yat limandan geçti."}]},{"id":"gen-b1-yacht-v","partOfSpeech":"v.","turkishMeanings":["yatla gezmek","yat yarışına katılmak"],"examples":[{"en":"They yacht around the islands each June.","tr":"Her haziran adalar arasında yatla geziyorlar."},{"en":"He yachted along the southern coast.","tr":"Güney kıyısı boyunca yatla gezdi."},{"en":"She yachts every summer with friends.","tr":"Her yaz arkadaşlarıyla yatla geziyor."}]}],"variants":[],"phonetic":"/jɒt/","band":1},{"id":"gen-b2-yahoo","headword":"yahoo","cefr":"C1","sourceCollection":"extended","sourceOrder":3307,"sourceEntry":"yahoo n.","senses":[{"id":"gen-b2-yahoo-n","partOfSpeech":"n.","turkishMeanings":["kaba kimse","görgüsüz"],"examples":[{"en":"A group of yahoos shouted outside.","tr":"Bir grup kaba adam dışarıda bağırdı."},{"en":"He behaved like a yahoo.","tr":"Görgüsüz biri gibi davrandı."},{"en":"The yahoos wrecked the bench.","tr":"Kaba adamlar bankı parçaladı."}]}],"variants":[],"phonetic":"/ˈjɑːhuː/","band":2},{"id":"gen-b2-yak","headword":"yak","cefr":"C1","sourceCollection":"extended","sourceOrder":3338,"sourceEntry":"yak n., v.","senses":[{"id":"gen-b2-yak-n","partOfSpeech":"n.","turkishMeanings":["yak öküzü","Tibet öküzü","gevezelik"],"examples":[{"en":"A yak carried the load.","tr":"Bir yak öküzü yükü taşıdı."},{"en":"The yak has thick shaggy hair.","tr":"Yak öküzünün kalın tüylü postu vardır."},{"en":"Their yak went on for an hour.","tr":"Gevezelikleri bir saat sürdü."}]},{"id":"gen-b2-yak-v","partOfSpeech":"v.","turkishMeanings":["gevezelik etmek","çene çalmak"],"examples":[{"en":"They yakked all afternoon.","tr":"Bütün öğleden sonra çene çaldılar."},{"en":"Stop yakking and listen.","tr":"Gevezeliği bırak ve dinle."},{"en":"He yakked on the phone for ages.","tr":"Telefonda uzun süre gevezelik etti."}]}],"variants":[],"phonetic":null,"band":2},{"id":"gen-b1-yakuza","headword":"yakuza","cefr":"C1","sourceCollection":"extended","sourceOrder":1276,"sourceEntry":"yakuza n.","senses":[{"id":"gen-b1-yakuza-n","partOfSpeech":"n.","turkishMeanings":["yakuza","Japon mafyası"],"examples":[{"en":"The film is about the yakuza.","tr":"Film yakuzayı anlatıyor."},{"en":"The yakuza controlled the district.","tr":"Yakuza bölgeyi kontrol ediyordu."},{"en":"Police investigated the yakuza for years.","tr":"Polis yakuzayı yıllarca soruşturdu."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b3-yam","headword":"yam","cefr":"C1","sourceCollection":"extended","sourceOrder":4541,"sourceEntry":"yam n.","senses":[{"id":"gen-b3-yam-n","partOfSpeech":"n.","turkishMeanings":["yam kökü","tatlı patates"],"examples":[{"en":"They boiled a yam for dinner.","tr":"Akşam yemeği için bir yam kökü haşladılar."},{"en":"The yam grows in warm soil.","tr":"Yam kökü sıcak toprakta yetişir."},{"en":"She roasted the yam slowly.","tr":"Yam kökünü yavaşça fırınladı."}]}],"variants":[],"phonetic":null,"band":3},{"id":"gen-b1-yank","headword":"yank","cefr":"C1","sourceCollection":"extended","sourceOrder":1962,"sourceEntry":"yank v.","senses":[{"id":"gen-b1-yank-v","partOfSpeech":"v.","turkishMeanings":["hızla çekmek","asılmak","koparmak"],"examples":[{"en":"He yanked the door open.","tr":"Kapıyı hızla çekip açtı."},{"en":"She yanked the cable out.","tr":"Kabloyu asılarak çıkardı."},{"en":"Do not yank the rope so hard.","tr":"İpi bu kadar sert çekme."}]}],"variants":[],"phonetic":"/jæŋk/","band":1},{"id":"gen-b3-yap","headword":"yap","cefr":"C1","sourceCollection":"extended","sourceOrder":4928,"sourceEntry":"yap n., v.","senses":[{"id":"gen-b3-yap-n","partOfSpeech":"n.","turkishMeanings":["kısa havlama","gevezelik"],"examples":[{"en":"The dog gave a sharp yap.","tr":"Köpek keskin bir havlama çıkardı."},{"en":"A yap came from the hall.","tr":"Koridordan bir havlama geldi."},{"en":"Enough of that yap.","tr":"Bu gevezelik yeter."}]},{"id":"gen-b3-yap-v","partOfSpeech":"v.","turkishMeanings":["kısa kısa havlamak","gevezelik etmek"],"examples":[{"en":"The little dog yapped at us.","tr":"Küçük köpek bize havladı."},{"en":"He yapped on for an hour.","tr":"Bir saat gevezelik etti."},{"en":"The puppy yapped all night.","tr":"Yavru köpek bütün gece havladı."}]}],"variants":[],"phonetic":"/jæp/","band":3},{"id":"gen-b2-yarn","headword":"yarn","cefr":"C1","sourceCollection":"extended","sourceOrder":3683,"sourceEntry":"yarn n., v.","senses":[{"id":"gen-b2-yarn-n","partOfSpeech":"n.","turkishMeanings":["iplik","yün","uzun hikâye"],"examples":[{"en":"She bought red yarn.","tr":"Kırmızı iplik aldı."},{"en":"The yarn is soft wool.","tr":"İplik yumuşak yündür."},{"en":"He told us a long yarn.","tr":"Bize uzun bir hikâye anlattı."}]},{"id":"gen-b2-yarn-v","partOfSpeech":"v.","turkishMeanings":["hikâye anlatmak","sohbet etmek"],"examples":[{"en":"They yarned late into the night.","tr":"Gece geç saatlere kadar sohbet ettiler."},{"en":"The old sailor yarned about storms.","tr":"Yaşlı denizci fırtına hikâyeleri anlattı."},{"en":"We yarned by the fire.","tr":"Ateşin yanında sohbet ettik."}]}],"variants":[],"phonetic":"/jɑːn/","band":2},{"id":"gen-b3-yawn","headword":"yawn","cefr":"C1","sourceCollection":"extended","sourceOrder":4646,"sourceEntry":"yawn n., v.","senses":[{"id":"gen-b3-yawn-n","partOfSpeech":"n.","turkishMeanings":["esneme","can sıkıcı şey"],"examples":[{"en":"She gave a wide yawn.","tr":"Geniş bir esneme yaptı."},{"en":"The yawn showed he was tired.","tr":"Esneme yorgun olduğunu gösterdi."},{"en":"The film is a total yawn.","tr":"Film tam bir sıkıntı."}]},{"id":"gen-b3-yawn-v","partOfSpeech":"v.","turkishMeanings":["esnemek","açılmak"],"examples":[{"en":"He yawned through the lecture.","tr":"Ders boyunca esnedi."},{"en":"A gap yawned before them.","tr":"Önlerinde bir boşluk açıldı."},{"en":"She yawned and stretched.","tr":"Esnedi ve gerindi."}]}],"variants":[],"phonetic":"/jɔːn/","band":3},{"id":"gen-b2-yawning","headword":"yawning","cefr":"C1","sourceCollection":"extended","sourceOrder":3551,"sourceEntry":"yawning adj., n.","senses":[{"id":"gen-b2-yawning-adj","partOfSpeech":"adj.","turkishMeanings":["esneyen","kocaman açık","uçsuz"],"examples":[{"en":"A yawning gap opened in the wall.","tr":"Duvarda kocaman bir boşluk açıldı."},{"en":"The yawning student left early.","tr":"Esneyen öğrenci erken çıktı."},{"en":"There is a yawning difference between them.","tr":"Aralarında uçurum gibi bir fark var."}]},{"id":"gen-b2-yawning-n","partOfSpeech":"n.","turkishMeanings":["esneme"],"examples":[{"en":"His yawning annoyed the teacher.","tr":"Esnemesi öğretmeni rahatsız etti."},{"en":"Yawning is often contagious.","tr":"Esneme çoğu zaman bulaşıcıdır."},{"en":"The yawning stopped after coffee.","tr":"Kahveden sonra esneme durdu."}]}],"variants":[],"phonetic":null,"band":2},{"id":"gen-b1-yea","headword":"yea","cefr":"C1","sourceCollection":"extended","sourceOrder":514,"sourceEntry":"yea adv., n.","senses":[{"id":"gen-b1-yea-adv","partOfSpeech":"adv.","turkishMeanings":["evet","hatta","gerçekten"],"examples":[{"en":"Yea, it shall be done.","tr":"Evet, bu yapılacak."},{"en":"He was brave, yea, fearless.","tr":"Cesurdu, hatta korkusuzdu."},{"en":"Yea, the words were true.","tr":"Gerçekten, sözler doğruydu."}]},{"id":"gen-b1-yea-n","partOfSpeech":"n.","turkishMeanings":["kabul oyu","evet oyu"],"examples":[{"en":"The motion passed with thirty yeas.","tr":"Önerge otuz kabul oyuyla geçti."},{"en":"Count the yeas and the nays.","tr":"Kabul ve ret oylarını say."},{"en":"His yea decided the vote.","tr":"Onun evet oyu oylamayı belirledi."}]}],"variants":[],"phonetic":"/jeɪ/","band":1},{"id":"gen-b2-yearbook","headword":