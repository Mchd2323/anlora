tr":"Yoğurt koyu ve ekşiydi."},{"en":"He mixed fruit into the yogurt.","tr":"Yoğurda meyve karıştırdı."}]}],"variants":[],"phonetic":"/ˈjɒɡət/","band":1},{"id":"gen-b2-yonder","headword":"yonder","cefr":"C1","sourceCollection":"extended","sourceOrder":2473,"sourceEntry":"yonder adj., adv.","senses":[{"id":"gen-b2-yonder-adj","partOfSpeech":"adj.","turkishMeanings":["ötedeki","şuradaki"],"examples":[{"en":"Take the yonder path.","tr":"Şuradaki patikayı tut."},{"en":"The yonder hill is steep.","tr":"Ötedeki tepe dik."},{"en":"He pointed to the yonder field.","tr":"Ötedeki tarlayı işaret etti."}]},{"id":"gen-b2-yonder-adv","partOfSpeech":"adv.","turkishMeanings":["ötede","şurada","ilerde"],"examples":[{"en":"The house stands over yonder.","tr":"Ev şurada ötede duruyor."},{"en":"Look yonder, past the trees.","tr":"Şuraya bak, ağaçların ötesine."},{"en":"They camped yonder by the stream.","tr":"Şurada, derenin yanında kamp kurdular."}]}],"variants":[],"phonetic":"/ˈjɒndə(ɹ)/","band":2},{"id":"gen-b2-youthful","headword":"youthful","cefr":"C1","sourceCollection":"extended","sourceOrder":2605,"sourceEntry":"youthful adj.","senses":[{"id":"gen-b2-youthful-adj","partOfSpeech":"adj.","turkishMeanings":["genç","gençlik dolu","dinç"],"examples":[{"en":"He has a youthful face.","tr":"Genç bir yüzü var."},{"en":"She kept her youthful energy.","tr":"Gençlik enerjisini korudu."},{"en":"It was a youthful mistake.","tr":"Gençlik hatasıydı."}]}],"variants":[],"phonetic":"/ˈjuːθfəl/","band":2},{"id":"gen-b1-yummy","headword":"yummy","cefr":"C1","sourceCollection":"extended","sourceOrder":971,"sourceEntry":"yummy adj.","senses":[{"id":"gen-b1-yummy-adj","partOfSpeech":"adj.","turkishMeanings":["nefis","çok lezzetli","mis gibi"],"examples":[{"en":"The cake smells yummy.","tr":"Kek nefis kokuyor."},{"en":"That was a yummy dinner.","tr":"Çok lezzetli bir akşam yemeğiydi."},{"en":"The children said the soup was yummy.","tr":"Çocuklar çorbanın nefis olduğunu söyledi."}]}],"variants":[],"phonetic":"/ˈjʌm.i/","band":1}]
