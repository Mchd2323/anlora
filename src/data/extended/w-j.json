":4414,"sourceEntry":"java n.","senses":[{"id":"gen-b3-java-n","partOfSpeech":"n.","turkishMeanings":["kahve","java kahvesi"],"examples":[{"en":"He poured a cup of java.","tr":"Bir fincan kahve doldurdu."},{"en":"The java was strong and black.","tr":"Kahve sert ve sadeydi."},{"en":"She likes her java hot.","tr":"Kahvesini sıcak seviyor."}]}],"variants":[],"phonetic":"/ˈdʒɑːvə/","band":3},{"id":"gen-b1-jaw","headword":"jaw","cefr":"C1","sourceCollection":"extended","sourceOrder":656,"sourceEntry":"jaw n., v.","senses":[{"id":"gen-b1-jaw-n","partOfSpeech":"n.","turkishMeanings":["çene","çene kemiği"],"examples":[{"en":"He broke his jaw in the accident.","tr":"Kazada çenesini kırdı."},{"en":"The dog held the stick in its jaws.","tr":"Köpek çubuğu çenesinde tuttu."},{"en":"Her jaw dropped in surprise.","tr":"Şaşkınlıktan çenesi düştü."}]},{"id":"gen-b1-jaw-v","partOfSpeech":"v.","turkishMeanings":["çene çalmak","uzun uzun konuşmak"],"examples":[{"en":"They jawed for hours about football.","tr":"Saatlerce futbol üstüne çene çaldılar."},{"en":"He jawed at me about the rules.","tr":"Kurallar hakkında bana uzun uzun anlattı."},{"en":"Stop jawing and start working.","tr":"Çene çalmayı bırak da işe başla."}]}],"variants":[],"phonetic":"/d͡ʒɔː/","band":1},{"id":"gen-b1-jay","headword":"jay","cefr":"C1","sourceCollection":"extended","sourceOrder":95,"sourceEntry":"jay n.","senses":[{"id":"gen-b1-jay-n","partOfSpeech":"n.","turkishMeanings":["alakarga"],"examples":[{"en":"A jay screeched in the oak tree.","tr":"Meşe ağacında bir alakarga cıyakladı."},{"en":"The jay has bright blue feathers.","tr":"Alakarganın parlak mavi tüyleri var."},{"en":"A jay buried acorns in the garden.","tr":"Bir alakarga bahçeye palamut gömdü."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b3-jazzy","headword":"jazzy","cefr":"C1","sourceCollection":"extended","sourceOrder":4504,"sourceEntry":"jazzy adj.","senses":[{"id":"gen-b3-jazzy-adj","partOfSpeech":"adj.","turkishMeanings":["cazımsı","canlı","cafcaflı"],"examples":[{"en":"The tune is jazzy and quick.","tr":"Ezgi cazımsı ve hızlı."},{"en":"He wore a jazzy tie.","tr":"Cafcaflı bir kravat takmıştı."},{"en":"The cover has a jazzy design.","tr":"Kapağın canlı bir tasarımı var."}]}],"variants":[],"phonetic":"/ˈdʒæzi/","band":3},{"id":"gen-b1-jealous","headword":"jealous","cefr":"C1","sourceCollection":"extended","sourceOrder":28,"sourceEntry":"jealous adj.","senses":[{"id":"gen-b1-jealous-adj","partOfSpeech":"adj.","turkishMeanings":["kıskanç","haset","kıskanan"],"examples":[{"en":"He is jealous of his brother.","tr":"Kardeşini kıskanıyor."},{"en":"She felt jealous when he left.","tr":"O gidince kıskançlık hissetti."},{"en":"Do not be jealous of others.","tr":"Başkalarını kıskanma."}]}],"variants":[],"phonetic":"/ˈdʒɛləs/","band":1},{"id":"gen-b1-jealousy","headword":"jealousy","cefr":"C1","sourceCollection":"extended","sourceOrder":527,"sourceEntry":"jealousy n.","senses":[{"id":"gen-b1-jealousy-n","partOfSpeech":"n.","turkishMeanings":["kıskançlık","haset"],"examples":[{"en":"Jealousy ruined their friendship.","tr":"Kıskançlık dostluklarını mahvetti."},{"en":"He could not hide his jealousy.","tr":"Kıskançlığını gizleyemedi."},{"en":"Jealousy is a heavy burden.","tr":"Kıskançlık ağır bir yüktür."}]}],"variants":[],"phonetic":"/ˈdʒɛləsi/","band":1},{"id":"gen-b1-jeep","headword":"jeep","cefr":"C1","sourceCollection":"extended","sourceOrder":590,"sourceEntry":"jeep n.","senses":[{"id":"gen-b1-jeep-n","partOfSpeech":"n.","turkishMeanings":["cip","arazi aracı"],"examples":[{"en":"The jeep crossed the muddy field.","tr":"Cip çamurlu tarlayı geçti."},{"en":"They travelled by jeep for two days.","tr":"İki gün cip ile yolculuk ettiler."},{"en":"The jeep needs new tyres.","tr":"Cipin yeni lastiğe ihtiyacı var."}]}],"variants":[],"phonetic":"/dʒiːp/","band":1},{"id":"gen-b1-jelly","headword":"jelly","cefr":"C1","sourceCollection":"extended","sourceOrder":648,"sourceEntry":"jelly n., v.","senses":[{"id":"gen-b1-jelly-n","partOfSpeech":"n.","turkishMeanings":["jöle","pelte","marmelat"],"examples":[{"en":"The children ate jelly and ice cream.","tr":"Çocuklar jöle ve dondurma yedi."},{"en":"The jelly set in the fridge.","tr":"Jöle buzdolabında dondu."},{"en":"She spread jelly on the toast.","tr":"Tosta marmelat sürdü."}]},{"id":"gen-b1-jelly-v","partOfSpeech":"v.","turkishMeanings":["pelteleşmek","donmak"],"examples":[{"en":"The sauce jellied as it cooled.","tr":"Sos soğudukça pelteleşti."},{"en":"The stock jellied overnight.","tr":"Et suyu bir gecede dondu."},{"en":"The mixture jellied in the fridge.","tr":"Karışım buzdolabında pelteleşti."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b2-jellyfish","headword":"jellyfish","cefr":"C1","sourceCollection":"extended","sourceOrder":2937,"sourceEntry":"jellyfish n.","senses":[{"id":"gen-b2-jellyfish-n","partOfSpeech":"n.","turkishMeanings":["denizanası"],"examples":[{"en":"A jellyfish stung her leg.","tr":"Bir denizanası bacağını soktu."},{"en":"Jellyfish drift with the current.","tr":"Denizanaları akıntıyla sürüklenir."},{"en":"The jellyfish was almost transparent.","tr":"Denizanası neredeyse saydamdı."}]}],"variants":[],"phonetic":"/ˈdʒɛliˌfɪʃ/","band":2},{"id":"gen-b2-jeopardize","headword":"jeopardize","cefr":"C1","sourceCollection":"extended","sourceOrder":2715,"sourceEntry":"jeopardize v.","senses":[{"id":"gen-b2-jeopardize-v","partOfSpeech":"v.","turkishMeanings":["tehlikeye atmak","riske sokmak"],"examples":[{"en":"The delay jeopardized the deal.","tr":"Gecikme anlaşmayı riske soktu."},{"en":"Do not jeopardize your health.","tr":"Sağlığını tehlikeye atma."},{"en":"One mistake jeopardized everything.","tr":"Tek bir hata her şeyi tehlikeye attı."}]}],"variants":[],"phonetic":null,"band":2},{"id":"gen-b1-jeopardy","headword":"jeopardy","cefr":"C1","sourceCollection":"extended","sourceOrder":1619,"sourceEntry":"jeopardy n.","senses":[{"id":"gen-b1-jeopardy-n","partOfSpeech":"n.","turkishMeanings":["tehlike","risk"],"examp