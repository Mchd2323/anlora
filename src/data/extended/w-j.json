[{"id":"gen-b1-jab","headword":"jab","cefr":"C1","sourceCollection":"extended","sourceOrder":1879,"sourceEntry":"jab n., v.","senses":[{"id":"gen-b1-jab-n","partOfSpeech":"n.","turkishMeanings":["dürtme","yumruk","iğne"],"examples":[{"en":"He gave me a jab in the ribs.","tr":"Kaburgalarıma bir dürtme attı."},{"en":"The boxer landed a quick jab.","tr":"Boksör hızlı bir yumruk attı."},{"en":"The nurse gave her a jab.","tr":"Hemşire ona bir iğne yaptı."}]},{"id":"gen-b1-jab-v","partOfSpeech":"v.","turkishMeanings":["dürtmek","saplamak","yumruk atmak"],"examples":[{"en":"She jabbed him with her elbow.","tr":"Dirseğiyle onu dürttü."},{"en":"He jabbed the button twice.","tr":"Düğmeye iki kez bastı."},{"en":"The fighter jabbed at his opponent.","tr":"Dövüşçü rakibine yumruk attı."}]}],"variants":[],"phonetic":"/dʒæb/","band":1},{"id":"gen-b3-jackal","headword":"jackal","cefr":"C1","sourceCollection":"extended","sourceOrder":4255,"sourceEntry":"jackal n.","senses":[{"id":"gen-b3-jackal-n","partOfSpeech":"n.","turkishMeanings":["çakal","yardakçı"],"examples":[{"en":"A jackal howled in the night.","tr":"Gece bir çakal uludu."},{"en":"Jackals feed on what lions leave.","tr":"Çakallar aslanların bıraktığıyla beslenir."},{"en":"He acted as the boss's jackal.","tr":"Patronun yardakçısı gibi davrandı."}]}],"variants":[],"phonetic":"/ˈdʒækəl/","band":3},{"id":"gen-b1-jackpot","headword":"jackpot","cefr":"C1","sourceCollection":"extended","sourceOrder":1204,"sourceEntry":"jackpot n.","senses":[{"id":"gen-b1-jackpot-n","partOfSpeech":"n.","turkishMeanings":["büyük ikramiye","vurgun"],"examples":[{"en":"She won the jackpot last night.","tr":"Dün gece büyük ikramiyeyi kazandı."},{"en":"The jackpot reached a record amount.","tr":"İkramiye rekor bir tutara ulaştı."},{"en":"He hit the jackpot with that idea.","tr":"O fikirle büyük vurgun yaptı."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b2-jacks","headword":"jacks","cefr":"C1","sourceCollection":"extended","sourceOrder":2156,"sourceEntry":"jacks n.","senses":[{"id":"gen-b2-jacks-n","partOfSpeech":"n.","turkishMeanings":["beş taş oyunu","aşık kemikleri oyunu"],"examples":[{"en":"The children played jacks on the step.","tr":"Çocuklar basamakta beş taş oynadı."},{"en":"She won every game of jacks.","tr":"Her beş taş oyununu kazandı."},{"en":"A set of jacks lay in the box.","tr":"Kutuda bir beş taş takımı vardı."}]}],"variants":[],"phonetic":"/dʒæks/","band":2},{"id":"gen-b1-jade","headword":"jade","cefr":"C1","sourceCollection":"extended","sourceOrder":575,"sourceEntry":"jade adj., n., v.","senses":[{"id":"gen-b1-jade-adj","partOfSpeech":"adj.","turkishMeanings":["yeşim yeşili","koyu yeşil"],"examples":[{"en":"She wore a jade dress.","tr":"Yeşim yeşili bir elbise giymişti."},{"en":"The sea had a jade colour.","tr":"Denizin yeşim yeşili bir rengi vardı."},{"en":"He painted the door jade.","tr":"Kapıyı yeşim yeşiline boyadı."}]},{"id":"gen-b1-jade-n","partOfSpeech":"n.","turkishMeanings":["yeşim","yeşim taşı"],"examples":[{"en":"The ring is made of green jade.","tr":"Yüzük yeşil yeşimden yapılmış."},{"en":"She collects small jade figures.","tr":"Küçük yeşim heykelcikler topluyor."},{"en":"Jade is valued in many cultures.","tr":"Yeşim birçok kültürde değerlidir."}]},{"id":"gen-b1-jade-v","partOfSpeech":"v.","turkishMeanings":["yormak","bıktırmak"],"examples":[{"en":"The long journey jaded the travellers.","tr":"Uzun yolculuk yolcuları yordu."},{"en":"Years of work jaded him completely.","tr":"Yıllarca süren iş onu tamamen bıktırdı."},{"en":"Too much noise jades the mind.","tr":"Fazla gürültü zihni yorar."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b2-jag","headword":"jag","cefr":"C1","sourceCollection":"extended","sourceOrder":2632,"sourceEntry":"jag n., v.","senses":[{"id":"gen-b2-jag-n","partOfSpeech":"n.","turkishMeanings":["sivri çıkıntı","çentik","nöbet"],"examples":[{"en":"A jag of rock tore his coat.","tr":"Sivri bir kaya çıkıntısı paltosunu yırttı."},{"en":"The edge has a sharp jag.","tr":"Kenarda keskin bir çentik var."},{"en":"He went on a crying jag.","tr":"Bir ağlama nöbetine tutuldu."}]},{"id":"gen-b2-jag-v","partOfSpeech":"v.","turkishMeanings":["çentmek","tırtıklamak","dişli kesmek"],"examples":[{"en":"The knife jagged the paper.","tr":"Bıçak kâğıdı tırtıkladı."},{"en":"Wind jagged the edge of the ice.","tr":"Rüzgâr buzun kenarını çentti."},{"en":"He jagged the cloth with scissors.","tr":"Kumaşı makasla tırtıkladı."}]}],"variants":[],"phonetic":null,"band":2},{"id":"gen-b2-jaguar","headword":"jaguar","cefr":"C1","sourceCollection":"extended","sourceOrder":2452,"sourceEntry":"jaguar n.","senses":[{"id":"gen-b2-jaguar-n","partOfSpeech":"n.","turkishMeanings":["jaguar","benekli Amerika kaplanı"],"examples":[{"en":"A jaguar hunted near the river.","tr":"Bir jaguar nehrin yanında avlandı."},{"en":"The jaguar has a spotted coat.","tr":"Jaguarın benekli bir postu var."},{"en":"Jaguars live in dense forest.","tr":"Jaguarlar sık ormanda yaşar."}]}],"variants":[],"phonetic":"/ˈdʒæɡjʊə/","band":2},{"id":"gen-b1-janitor","headword":"janitor","cefr":"C1","sourceCollection":"extended","sourceOrder":920,"sourceEntry":"janitor n.","senses":[{"id":"gen-b1-janitor-n","partOfSpeech":"n.","turkishMeanings":["kapıcı","hademe","bina görevlisi"],"examples":[{"en":"The janitor locks the school at night.","tr":"Hademe okulu geceleri kilitliyor."},{"en":"Ask the janitor for a spare key.","tr":"Yedek anahtarı kapıcıdan iste."},{"en":"The janitor cleaned the corridor.","tr":"Bina görevlisi koridoru temizledi."}]}],"variants":[],"phonetic":"/ˈd͡ʒænɪtə/","band":1},{"id":"gen-b1-japan","headword":"japan","cefr":"C1","sourceCollection":"extended","sourceOrder":55,"sourceEntry":"japan n., v.","senses":[{"id":"gen-b1-japan-n","partOfSpeech":"n.","turkishMeanings":["lake","siyah vernik"],"examples":[{"en":"The tray is finished with black japan.","tr":"Tepsi siyah lakeyle kaplanmış."},{"en":"He applied japan to the metal box.","tr":"Metal kutuya lake sürdü."},{"