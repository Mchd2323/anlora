ey","cefr":"C1","sourceCollection":"extended","sourceOrder":202,"sourceEntry":"jersey n.","senses":[{"id":"gen-b1-jersey-n","partOfSpeech":"n.","turkishMeanings":["forma","kazak","örgü kumaş"],"examples":[{"en":"The player wore a red jersey.","tr":"Oyuncu kırmızı bir forma giymişti."},{"en":"She bought a warm wool jersey.","tr":"Sıcak yünlü bir kazak aldı."},{"en":"His jersey had the number nine.","tr":"Formasında dokuz numara vardı."}]}],"variants":[],"phonetic":"/ˈdʒɜːzi/","band":1},{"id":"gen-b3-jest","headword":"jest","cefr":"C1","sourceCollection":"extended","sourceOrder":4289,"sourceEntry":"jest n., v.","senses":[{"id":"gen-b3-jest-n","partOfSpeech":"n.","turkishMeanings":["şaka","espri","latife"],"examples":[{"en":"He said it in jest.","tr":"Bunu şaka olsun diye söyledi."},{"en":"The jest fell flat.","tr":"Şaka tutmadı."},{"en":"It was a harmless jest.","tr":"Zararsız bir latifeydi."}]},{"id":"gen-b3-jest-v","partOfSpeech":"v.","turkishMeanings":["şaka yapmak","latife etmek"],"examples":[{"en":"He jested about his own age.","tr":"Kendi yaşıyla şaka yaptı."},{"en":"Do not jest at such a time.","tr":"Böyle bir zamanda şaka yapma."},{"en":"She jested to lighten the mood.","tr":"Havayı yumuşatmak için şaka yaptı."}]}],"variants":[],"phonetic":"/dʒɛst/","band":3},{"id":"gen-b1-jewelry","headword":"jewelry","cefr":"C1","sourceCollection":"extended","sourceOrder":270,"sourceEntry":"jewelry n.","senses":[{"id":"gen-b1-jewelry-n","partOfSpeech":"n.","turkishMeanings":["mücevher","takı"],"examples":[{"en":"She keeps her jewelry in a box.","tr":"Takılarını bir kutuda saklıyor."},{"en":"The jewelry was very expensive.","tr":"Mücevher çok pahalıydı."},{"en":"He sells handmade jewelry.","tr":"El yapımı takı satıyor."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b2-jiffy","headword":"jiffy","cefr":"C1","sourceCollection":"extended","sourceOrder":3680,"sourceEntry":"jiffy n.","senses":[{"id":"gen-b2-jiffy-n","partOfSpeech":"n.","turkishMeanings":["an","kısa süre","