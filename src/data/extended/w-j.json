y jingle.","tr":"Reklamın akılda kalıcı bir ezgisi var."},{"en":"The jingle of bells filled the street.","tr":"Çan şıngırtısı sokağı doldurdu."}]},{"id":"gen-b1-jingle-v","partOfSpeech":"v.","turkishMeanings":["şıngırdamak","tıngırdatmak"],"examples":[{"en":"Coins jingled in his pocket.","tr":"Cebinde bozuk paralar şıngırdadı."},{"en":"She jingled the keys impatiently.","tr":"Anahtarları sabırsızca şıngırdattı."},{"en":"Bells jingled on the horse's harness.","tr":"Atın koşumunda çanlar şıngırdadı."}]}],"variants":[],"phonetic":"/ˈdʒɪŋɡəl/","band":1},{"id":"gen-b1-jinx","headword":"jinx","cefr":"C1","sourceCollection":"extended","sourceOrder":1860,"sourceEntry":"jinx n., v.","senses":[{"id":"gen-b1-jinx-n","partOfSpeech":"n.","turkishMeanings":["uğursuzluk","nazar","şanssızlık getiren şey"],"examples":[{"en":"That car is a jinx.","tr":"O araba bir uğursuzluk."},{"en":"They believe the room carries a jinx.","tr":"Odanın uğursuzluk taşıdığına inanıyorlar."},{"en":"He broke the jinx with a win.","tr":"Bir galibiyetle uğursuzluğu kırdı."}]},{"id":"gen-b1-jinx-v","partOfSpeech":"v.","turkishMeanings":["uğursuzluk getirmek","nazar değdirmek"],"examples":[{"en":"Do not jinx the game by talking.","tr":"Konuşarak maça nazar değdirme."},{"en":"He thinks he jinxed the trip.","tr":"Yolculuğa uğursuzluk getirdiğini düşünüyor."},{"en":"She jinxed it by celebrating early.","tr":"Erken kutlayarak nazar değdirdi."}]}],"variants":[],"phonetic":"/dʒɪŋks/","band":1},{"id":"gen-b3-jive","headword":"jive","cefr":"C1","sourceCollection":"extended","sourceOrder":4453,"sourceEntry":"jive n., v.","senses":[{"id":"gen-b3-jive-n","partOfSpeech":"n.","turkishMeanings":["jive dansı","swing müziği","boş laf"],"examples":[{"en":"They danced the jive.","tr":"Jive dansı yaptılar."},{"en":"The band played some jive.","tr":"Grup biraz swing çaldı."},{"en":"Do not give me that jive.","tr":"Bana o boş lafı yapma."}]},{"id":"gen-b3-jive-v","partOfSpeech":"v.","turkishMeanings":["jive dansı yapmak","boş ko