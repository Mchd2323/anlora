[{"id":"gen-b1-quack","headword":"quack","cefr":"C1","sourceCollection":"extended","sourceOrder":1554,"sourceEntry":"quack adj., n., v.","senses":[{"id":"gen-b1-quack-adj","partOfSpeech":"adj.","turkishMeanings":["sahte","şarlatan"],"examples":[{"en":"He sold quack remedies.","tr":"Sahte ilaçlar sattı."},{"en":"Avoid quack doctors.","tr":"Şarlatan doktorlardan kaçın."},{"en":"That is a quack treatment.","tr":"Bu sahte bir tedavidir."}]},{"id":"gen-b1-quack-n","partOfSpeech":"n.","turkishMeanings":["vak sesi","sahte doktor","şarlatan"],"examples":[{"en":"We heard the quack of a duck.","tr":"Bir ördeğin vak sesini duyduk."},{"en":"That doctor is a quack.","tr":"O doktor bir şarlatan."},{"en":"The quack sold useless medicine.","tr":"Şarlatan işe yaramaz ilaç sattı."}]},{"id":"gen-b1-quack-v","partOfSpeech":"v.","turkishMeanings":["vaklamak"],"examples":[{"en":"The ducks quacked by the pond.","tr":"Ördekler göletin yanında vakladı."},{"en":"A duck quacked loudly at dawn.","tr":"Bir ördek şafakta yüksek sesle vakladı."},{"en":"The ducklings quacked for food.","tr":"Ördek yavruları yiyecek için vakladı."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b2-quad","headword":"quad","cefr":"C1","sourceCollection":"extended","sourceOrder":3975,"sourceEntry":"quad n.","senses":[{"id":"gen-b2-quad-n","partOfSpeech":"n.","turkishMeanings":["dörtlü avlu","dördüz","dört tekerlekli arazi aracı"],"examples":[{"en":"Students crossed the quad.","tr":"Öğrenciler avludan geçti."},{"en":"She rode a quad on the sand.","tr":"Kumda dört tekerlekli araç sürdü."},{"en":"The quad is grassy and quiet.","tr":"Avlu çimenli ve sessiz."}]}],"variants":[],"phonetic":null,"band":2},{"id":"gen-b2-quadrant","headword":"quadrant","cefr":"C1","sourceCollection":"extended","sourceOrder":2084,"sourceEntry":"quadrant n.","senses":[{"id":"gen-b2-quadrant-n","partOfSpeech":"n.","turkishMeanings":["çeyrek daire","bölge","kadran"],"examples":[{"en":"The city is divided into four quadrants.","tr":"Şehir dört bölgeye ayrılmış."},{"en":"Mark the point in the first quadrant.","tr":"Noktayı birinci çeyrekte işaretle."},{"en":"Sailors once used a quadrant.","tr":"Denizciler bir zamanlar kadran kullanırdı."}]}],"variants":[],"phonetic":"/ˈkwɑd.ɹənt/","band":2},{"id":"gen-b2-quagmire","headword":"quagmire","cefr":"C1","sourceCollection":"extended","sourceOrder":3584,"sourceEntry":"quagmire n.","senses":[{"id":"gen-b2-quagmire-n","partOfSpeech":"n.","turkishMeanings":["bataklık","içinden çıkılmaz durum"],"examples":[{"en":"The field turned into a quagmire.","tr":"Tarla bir bataklığa döndü."},{"en":"They sank into a legal quagmire.","tr":"Hukuki bir bataklığa saplandılar."},{"en":"The quagmire swallowed the wheel.","tr":"Bataklık tekerleği yuttu."}]}],"variants":[],"phonetic":"/ˈkwɒɡ.maɪə(ɹ)/","band":2},{"id":"gen-b3-quail","headword":"quail","cefr":"C1","sourceCollection":"extended","sourceOrder":4260,"sourceEntry":"quail n., v.","senses":[{"id":"gen-b3-quail-n","partOfSpeech":"n.","turkishMeanings":["bıldırcın"],"examples":[{"en":"A quail ran through the grass.","tr":"Bir bıldırcın çimenlerin arasından koştu."},{"en":"They served roast quail.","tr":"Fırında bıldırcın servis ettiler."},{"en":"The quail nests on the ground.","tr":"Bıldırcın yere yuva yapar."}]},{"id":"gen-b3-quail-v","partOfSpeech":"v.","turkishMeanings":["korkudan sinmek","yılmak","ürkmek"],"examples":[{"en":"He quailed at the sight.","tr":"Manzara karşısında sindi."},{"en":"She did not quail before them.","tr":"Onların önünde yılmadı."},{"en":"The men quailed at the order.","tr":"Adamlar emir karşısında ürktü."}]}],"variants":[],"phonetic":null,"band":3},{"id":"gen-b2-quaint","headword":"quaint","cefr":"C1","sourceCollection":"extended","sourceOrder":3310,"sourceEntry":"quaint adj.","senses":[{"id":"gen-b2-quaint-adj","partOfSpeech":"adj.","turkishMeanings":["şirin eski","tuhafça hoş","antika"],"examples":[{"en":"It is a quaint little village.","tr":"Şirin, eski bir köy."},{"en":"The custom seems quaint today.","tr":"Gelenek bugün tuhafça hoş görünüyor."},{"en":"They stayed in a quaint inn.","tr":"Şirin eski bir handa kaldılar."}]}],"variants":[],"phonetic":null,"band":2},{"id":"gen-b2-quake","headword":"quake","cefr":"C1","sourceCollection":"extended","sourceOrder":3752,"sourceEntry":"quake n., v.","senses":[{"id":"gen-b2-quake-n","partOfSpeech":"n.","turkishMeanings":["deprem","sarsıntı","titreme"],"examples":[{"en":"The quake damaged three houses.","tr":"Deprem üç eve zarar verdi."},{"en":"A small quake woke us.","tr":"Küçük bir sarsıntı bizi uyandırdı."},{"en":"The quake lasted ten seconds.","tr":"Deprem on saniye sürdü."}]},{"id":"gen-b2-quake-v","partOfSpeech":"v.","turkishMeanings":["sarsılmak","titremek","ürpermek"],"examples":[{"en":"The ground quaked beneath us.","tr":"Zemin altımızda sarsıldı."},{"en":"He quaked with fear.","tr":"Korkudan titredi."},{"en":"The windows quaked in the wind.","tr":"Pencereler rüzgârda titredi."}]}],"variants":[],"phonetic":"/kweɪk/","band":2},{"id":"gen-b1-quantum","headword":"quantum","cefr":"C1","sourceCollection":"extended","sourceOrder":935,"sourceEntry":"quantum n.","senses":[{"id":"gen-b1-quantum-n","partOfSpeech":"n.","turkishMeanings":["kuantum","nicelik birimi","miktar"],"examples":[{"en":"A quantum is the smallest unit of energy.","tr":"Kuantum en küçük enerji birimidir."},{"en":"The theory describes each quantum.","tr":"Kuram her kuantumu tanımlıyor."},{"en":"There was a quantum of truth in it.","tr":"İçinde bir miktar gerçek vardı."}]}],"variants":[],"phonetic":"/ˈkwɒntəm/","band":1},{"id":"gen-b1-quarantine","headword":"quarantine","cefr":"C1","sourceCollection":"extended","sourceOrder":1485,"sourceEntry":"quarantine n., v.","senses":[{"id":"gen-b1-quarantine-n","partOfSpeech":"n.","turkishMeanings":["karantina","tecrit"],"examples":[{"en":"The dog spent a month in quarantine.","tr":"Köpek bir ay karantinada kaldı."},{"en":"Quarantine helped stop the spread.","tr":"Karantina yayılmayı durdurmaya yardım etti."},{"en":"The ship was put under quarantine.","tr":"Gemi karantinaya alındı."}]},{"id":"gen-b1-quarantine-v","partOfSpeech":"v.","turkishMeanings":["karantinaya almak","tecrit etmek"],"examples":[{"en":"They quarantined the sick animals.","tr":"Hasta hayvanları karantinaya aldılar."},{"en":"Travellers were quarantined for ten days.","tr":"Yolcular on gün karantinaya alındı."},{"en":"The village was quarantined at once.","tr":"Köy hemen karantinaya alındı."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b2-quark","headword":"quark","cefr":"C1","sourceCollection":"extended","sourceOrder":4000,"sourceEntry":"quark n.","senses":[{"id":"gen-b2-quark-n","partOfSpeech":"n.","turkishMeanings":["kuark","temel parçacık"],"examples":[{"en":"A proton contains three quarks.","tr":"Bir proton üç kuark içerir."},{"en":"The quark cannot exist alone.","tr":"Kuark tek başına var olamaz."},{"en":"They study quark behaviour.","tr":"Kuark davranışını inceliyorlar."}]}],"variants":[],"phonetic":"/kwɑːk/","band":2},{"id":"gen-b1-quarrel","headword":"quarrel","cefr":"C1","sourceCollection":"extended","sourceOrder":793,"sourceEntry":"quarrel n., v.","senses":[{"id":"gen-b1-quarrel-n","partOfSpeech":"n.","turkishMeanings":["kavga","tartışma","anlaşmazlık"],"examples":[{"en":"They had a quarrel about money.","tr":"Para yüzünden bir kavga ettiler."},{"en":"The quarrel lasted for weeks.","tr":"Anlaşmazlık haftalarca sürdü."},{"en":"I have no quarrel with you.","tr":"Seninle bir alıp veremediğim yok."}]},{"id":"gen-b1-quarrel-v","partOfSpeech":"v.","turkishMeanings":["kavga etmek","tartışmak","itiraz etmek"],"examples":[{"en":"The brothers quarrelled all evening.","tr":"Kardeşler bütün akşam kavga etti."},{"en":"They quarrelled over the inheritance.","tr":"Miras yüzünden tartıştılar."},{"en":"I cannot quarrel with that decision.","tr":"O karara itiraz edemem."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b1-quarry","headword":"quarry","cefr":"C1","sourceCollection":"extended","sourceOrder":1570,"sourceEntry":"quarry n., v.","senses":[{"id":"gen-b1-quarry-n","partOfSpeech":"n.","turkishMeanings":["taş ocağı","av","hedef"],"examples":[{"en":"Stone came from a nearby quarry.","tr":"Taş yakındaki bir taş ocağından geldi."},{"en":"The quarry closed ten years ago.","tr":"Taş ocağı on yıl önce kapandı."},{"en":"The hunter lost his quarry.","tr":"Avcı avını kaybetti."}]},{"id":"gen-b1-quarry-v","partOfSpeech":"v.","turkishMeanings":["taş çıkarmak","araştırmak"],"examples":[{"en":"They quarried marble here for centuries.","tr":"Burada yüzyıllarca mermer çıkardılar."},{"en":"The company quarries limestone.","tr":"Şirket kireç taşı çıkarıyor."},{"en":"He quarried old records for facts.","tr":"Gerçekler için eski kayıtları araştırdı."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b4-quart","headword":"quart","cefr":"C1","sourceCollection":"extended","sourceOrder":6273,"sourceEntry":"quart n.","senses":[{"id":"gen-b4-quart-n","partOfSpeech":"n.","turkishMeanings":["çeyrek galon","bir hacim ölçüsü"],"examples":[{"en":"Buy a quart of milk.","tr":"Bir çeyrek galon süt al."},{"en":"The pot holds two quart.","tr":"Tencere iki ölçü alıyor."},{"en":"A quart is smaller than a gallon.","tr":"Bir çeyrek galon, galondan küçüktür."}]}],"variants":[],"phonetic":"/kwɔːt/","band":4},{"id":"gen-b1-quarterback","headword":"quarterback","cefr":"C1","sourceCollection":"extended","sourceOrder":1480,"sourceEntry":"quarterback n., v.","senses":[{"id":"gen-b1-quarterback-n","partOfSpeech":"n.","turkishMeanings":["oyun kurucu","takım yöneticisi"],"examples":[{"en":"The quarterback threw a long pass.","tr":"Oyun kurucu uzun bir pas attı."},{"en":"He was the best quarterback that season.","tr":"O sezonun en iyi oyun kurucusuydu."},{"en":"The quarterback led the final drive.","tr":"Oyun kurucu son atağı yönetti."}]},{"id":"gen-b1-quarterback-v","partOfSpeech":"v.","turkishMeanings":["yönetmek","oyun kurmak"],"examples":[{"en":"He quarterbacked the whole project.","tr":"Bütün projeyi yönetti."},{"en":"She quarterbacked the negotiations.","tr":"Görüşmeleri yönetti."},{"en":"He quarterbacked the team to victory.","tr":"Takımı zafere taşıdı."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b3-quartet","headword":"quartet","cefr":"C1","sourceCollection":"extended","sourceOrder":4670,"sourceEntry":"quartet n.","senses":[{"id":"gen-b3-quartet-n","partOfSpeech":"n.","turkishMeanings":["dörtlü","kuartet"],"examples":[{"en":"The quartet played Mozart.","tr":"Dörtlü Mozart çaldı."},{"en":"A string quartet performed.","tr":"Bir yaylı dörtlü sahne aldı."},{"en":"The quartet has two violins.","tr":"Dörtlüde iki keman var."}]}],"variants":[],"phonetic":"/kwɔː(ɹ)ˈtɛt/","band":3},{"id":"gen-b3-quartz","headword":"quartz","cefr":"C1","sourceCollection":"extended","sourceOrder":5518,"sourceEntry":"quartz n.","senses":[{"id":"gen-b3-quartz-n","partOfSpeech":"n.","turkishMeanings":["kuvars"],"examples":[{"en":"The watch has a quartz movement.","tr":"Saatin kuvars mekanizması var."},{"en":"Quartz is a common mineral.","tr":"Kuvars yaygın bir mineraldir."},{"en":"She found a piece of pink quartz.","tr":"Pembe bir kuvars parçası buldu."}]}],"variants":[],"phonetic":"/k(w)ɔːts/","band":3},{"id":"gen-b3-queasy","headword":"queasy","cefr":"C1","sourceCollection":"extended","sourceOrder":5610,"sourceEntry":"queasy adj.","senses":[{"id":"gen-b3-queasy-adj","partOfSpeech":"adj.","turkishMeanings":["midesi bulanan","tedirgin"],"examples":[{"en":"The boat made him queasy.","tr":"Tekne midesini bulandırdı."},{"en":"She felt queasy after the news.","tr":"Haberden sonra kendini tedirgin hissetti."},{"en":"Strong smells make me queasy.","tr":"Ağır kokular midemi bulandırıyor."}]}],"variants":[],"phonetic":"/ˈkwiː.zi/","band":3},{"id":"gen-b1-queer","headword":"queer","cefr":"C1","sourceCollection":"extended","sourceOrder":830,"sourceEntry":"queer adj., n., v.","senses":[{"id":"gen-b1-queer-adj","partOfSpeech":"adj.","turkishMeanings":["tuhaf","acayip","keyifsiz"],"examples":[{"en":"There was a queer smell in the hall.","tr":"Koridorda tuhaf bir koku vardı."},{"en":"He told a queer old story.","tr":"Acayip, eski bir hikâye anlattı."},{"en":"She felt queer after the meal.","tr":"Yemekten sonra kendini keyifsiz hissetti."}]},{"id":"gen-b1-queer-n","partOfSpeech":"n.","turkishMeanings":["tuhaf kimse"],"examples":[{"en":"The villagers called him a queer.","tr":"Köylüler ona tuhaf biri derdi."},{"en":"He was seen as a queer in that town.","tr":"O kasabada tuhaf biri olarak görülürdü."},{"en":"She never treated him as a queer.","tr":"Ona hiç tuhaf biriymiş gibi davranmadı."}]},{"id":"gen-b1-queer-v","partOfSpeech":"v.","turkishMeanings":["bozmak","berbat etmek"],"examples":[{"en":"He queered the deal at the last minute.","tr":"Anlaşmayı son dakikada bozdu."},{"en":"Do not queer our chances now.","tr":"Şansımızı şimdi berbat etme."},{"en":"The rumour queered his reputation.","tr":"Söylenti itibarını bozdu."}]}],"variants":[],"phonetic":"/kwɪɹ/","band":1},{"id":"gen-b3-quench","headword":"quench","cefr":"C1","sourceCollection":"extended","sourceOrder":5398,"sourceEntry":"quench v.","senses":[{"id":"gen-b3-quench-v","partOfSpeech":"v.","turkishMeanings":["gidermek","söndürmek"],"examples":[{"en":"Water quenches thirst best.","tr":"Susuzluğu en iyi su giderir."},{"en":"They quenched the fire with sand.","tr":"Ateşi kumla söndürdüler."},{"en":"Nothing could quench her curiosity.","tr":"Hiçbir şey merakını söndüremedi."}]}],"variants":[],"phonetic":"/kwɛnt͡ʃ/","band":3},{"id":"gen-b2-questionable","headword":"questionable","cefr":"C1","sourceCollection":"extended","sourceOrder":2679,"sourceEntry":"questionable adj.","senses":[{"id":"gen-b2-questionable-adj","partOfSpeech":"adj.","turkishMeanings":["şüpheli","tartışmalı","kuşku uyandıran"],"examples":[{"en":"The data is questionable.","tr":"Veriler şüpheli."},{"en":"He used questionable methods.","tr":"Tartışmalı yöntemler kullandı."},{"en":"Her motives are questionable.","tr":"Niyetleri ku