[{"id":"gen-b1-quack","headword":"quack","cefr":"C1","sourceCollection":"extended","sourceOrder":1554,"sourceEntry":"quack adj., n., v.","senses":[{"id":"gen-b1-quack-adj","partOfSpeech":"adj.","turkishMeanings":["sahte","şarlatan"],"examples":[{"en":"He sold quack remedies.","tr":"Sahte ilaçlar sattı."},{"en":"Avoid quack doctors.","tr":"Şarlatan doktorlardan kaçın."},{"en":"That is a quack treatment.","tr":"Bu sahte bir tedavidir."}]},{"id":"gen-b1-quack-n","partOfSpeech":"n.","turkishMeanings":["vak sesi","sahte doktor","şarlatan"],"examples":[{"en":"We heard the quack of a duck.","tr":"Bir ördeğin vak sesini duyduk."},{"en":"That doctor is a quack.","tr":"O doktor bir şarlatan."},{"en":"The quack sold useless medicine.","tr":"Şarlatan işe yaramaz ilaç sattı."}]},{"id":"gen-b1-quack-v","partOfSpeech":"v.","turkishMeanings":["vaklamak"],"examples":[{"en":"The ducks quacked by the pond.","tr":"Ördekler göletin yanında vakladı."},{"en":"A duck quacked loudly at dawn.","tr":"Bir ördek şafakta yüksek sesle vakladı."},{"en":"The ducklings quacked for food.","tr":"Ördek yavruları yiyecek için vakladı."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b2-quad","headword":"quad","cefr":"C1","sourceCollection":"extended","sourceOrder":3975,"sourceEntry":"quad n.","senses":[{"id":"gen-b2-quad-n","partOfSpeech":"n.","turkishMeanings":["dörtlü avlu","dördüz","dört tekerlekli arazi aracı"],"examples":[{"en":"Students crossed the quad.","tr":"Öğrenciler avludan geçti."},{"en":"She rode a quad on the sand.","tr":"Kumda dört tekerlekli araç sürdü."},{"en":"The quad is grassy and quiet.","tr":"Avlu çimenli ve sessiz."}]}],"variants":[],"phonetic":null,"band":2},{"id":"gen-b2-quadrant","headword":"quadrant","cefr":"C1","sourceCollection":"extended","sourceOrder":2084,"sourceEntry":"quadrant n.","senses":[{"id":"gen-b2-quadrant-n","partOfSpeech":"n.","turkishMeanings":["çeyrek daire","bölge","kadran"],"examples":[{"en":"The city is divided into four quadrants.","tr":"Şehir dör