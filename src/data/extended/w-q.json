ants":[],"phonetic":"/ˈkwɒɡ.maɪə(ɹ)/","band":2},{"id":"gen-b4-quahog","headword":"quahog","cefr":"C1","sourceCollection":"extended","sourceOrder":7900,"sourceEntry":"quahog n.","senses":[{"id":"gen-b4-quahog-n","partOfSpeech":"n.","turkishMeanings":["sert kabuklu deniz tarağı","yenilebilir midye türü"],"examples":[{"en":"They dug for quahog in the sand.","tr":"Kumda deniz tarağı için kazdılar."},{"en":"Quahog makes a rich chowder.","tr":"Bu midye koyu bir çorba yapar."},{"en":"The quahog shell is very thick.","tr":"Kabuğu çok kalındır."}]}],"variants":[],"phonetic":"/ˈkəʊ.hɒɡ/","band":4},{"id":"gen-b3-quail","headword":"quail","cefr":"C1","sourceCollection":"extended","sourceOrder":4260,"sourceEntry":"quail n., v.","senses":[{"id":"gen-b3-quail-n","partOfSpeech":"n.","turkishMeanings":["bıldırcın"],"examples":[{"en":"A quail ran through the grass.","tr":"Bir bıldırcın çimenlerin arasından koştu."},{"en":"They served roast quail.","tr":"Fırında bıldırcın servis ettiler."},{"en":"The quail nests on the ground.","tr":"Bıldırcın yere yuva yapar."}]},{"id":"gen-b3-quail-v","partOfSpeech":"v.","turkishMeanings":["korkudan sinmek","yılmak","ürkmek"],"examples":[{"en":"He quailed at the sight.","tr":"Manzara karşısında sindi."},{"en":"She did not quail before them.","tr":"Onların önünde yılmadı."},{"en":"The men quailed at the order.","tr":"Adamlar emir karşısında ürktü."}]}],"variants":[],"phonetic":null,"band":3},{"id":"gen-b2-quaint","headword":"quaint","cefr":"C1","sourceCollection":"extended","sourceOrder":3310,"sourceEntry":"quaint adj.","senses":[{"id":"gen-b2-quaint-adj","partOfSpeech":"adj.","turkishMeanings":["şirin eski","tuhafça hoş","antika"],"examples":[{"en":"It is a quaint little village.","tr":"Şirin, eski bir köy."},{"en":"The custom seems quaint today.","tr":"Gelenek bugün tuhafça hoş görünüyor."},{"en":"They stayed in a quaint inn.","tr":"Şirin eski bir handa kaldılar."}]}],"variants":[],"phonetic":null,"band":2},{"id":"gen-b2-quake","headword":"quake","