.","senses":[{"id":"gen-b1-quarrel-n","partOfSpeech":"n.","turkishMeanings":["kavga","tartışma","anlaşmazlık"],"examples":[{"en":"They had a quarrel about money.","tr":"Para yüzünden bir kavga ettiler."},{"en":"The quarrel lasted for weeks.","tr":"Anlaşmazlık haftalarca sürdü."},{"en":"I have no quarrel with you.","tr":"Seninle bir alıp veremediğim yok."}]},{"id":"gen-b1-quarrel-v","partOfSpeech":"v.","turkishMeanings":["kavga etmek","tartışmak","itiraz etmek"],"examples":[{"en":"The brothers quarrelled all evening.","tr":"Kardeşler bütün akşam kavga etti."},{"en":"They quarrelled over the inheritance.","tr":"Miras yüzünden tartıştılar."},{"en":"I cannot quarrel with that decision.","tr":"O karara itiraz edemem."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b1-quarry","headword":"quarry","cefr":"C1","sourceCollection":"extended","sourceOrder":1570,"sourceEntry":"quarry n., v.","senses":[{"id":"gen-b1-quarry-n","partOfSpeech":"n.","turkishMeanings":["taş ocağı","av","hedef"],"examples":[{"en":"Stone came from a nearby quarry.","tr":"Taş yakındaki bir taş ocağından geldi."},{"en":"The quarry closed ten years ago.","tr":"Taş ocağı on yıl önce kapandı."},{"en":"The hunter lost his quarry.","tr":"Avcı avını kaybetti."}]},{"id":"gen-b1-quarry-v","partOfSpeech":"v.","turkishMeanings":["taş çıkarmak","araştırmak"],"examples":[{"en":"They quarried marble here for centuries.","tr":"Burada yüzyıllarca mermer çıkardılar."},{"en":"The company quarries limestone.","tr":"Şirket kireç taşı çıkarıyor."},{"en":"He quarried old records for facts.","tr":"Gerçekler için eski kayıtları araştırdı."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b4-quart","headword":"quart","cefr":"C1","sourceCollection":"extended","sourceOrder":6273,"sourceEntry":"quart n.","senses":[{"id":"gen-b4-quart-n","partOfSpeech":"n.","turkishMeanings":["çeyrek galon","bir hacim ölçüsü"],"examples":[{"en":"Buy a quart of milk.","tr":"Bir çeyrek galon süt al."},{"en":"The pot holds two quart.","tr":"Tencere iki ölçü alıyor."},{"en":"A quart is smaller than a gallon.","tr":"Bir çeyrek galon, galondan küçüktür."}]}],"variants":[],"phonetic":"/kwɔːt/","band":4},{"id":"gen-b1-quarterback","headword":"quarterback","cefr":"C1","sourceCollection":"extended","sourceOrder":1480,"sourceEntry":"quarterback n., v.","senses":[{"id":"gen-b1-quarterback-n","partOfSpeech":"n.","turkishMeanings":["oyun kurucu","takım yöneticisi"],"examples":[{"en":"The quarterback threw a long pass.","tr":"Oyun kurucu uzun bir pas attı."},{"en":"He was the best quarterback that season.","tr":"O sezonun en iyi oyun kurucusuydu."},{"en":"The quarterback led the final drive.","tr":"Oyun kurucu son atağı yönetti."}]},{"id":"gen-b1-quarterback-v","partOfSpeech":"v.","turkishMeanings":["yönetmek","oyun kurmak"],"examples":[{"en":"He quarterbacked the whole project.","tr":"Bütün projeyi yönetti."},{"en":"She quarterbacked the negotiations.","tr":"Görüşmeleri yönetti."},{"en":"He quarterbacked the team to victory.","tr":"Takımı zafere taşıdı."}]}],"variants":[],"phonetic":null,"band":1},{"id":"gen-b4-quartermaster","headword":"quartermaster","cefr":"C1","sourceCollection":"extended","sourceOrder":7849,"sourceEntry":"quartermaster n.","senses":[{"id":"gen-b4-quartermaster-n","partOfSpeech":"n.","turkishMeanings":["levazım subayı","ikmal görevlisi"],"examples":[{"en":"The quartermaster issued the boots.","tr":"Levazım subayı botları dağıttı."},{"en":"Ask the quartermaster for blankets.","tr":"Battaniye için ikmal görevlisine sor."},{"en":"The quartermaster keeps careful lists.","tr":"Levazım subayı titiz listeler tutuyor."}]}],"variants":[],"phonetic":"/ˈk(w)ɔɹtɚˌmæstɚ/","band":4},{"id":"gen-b3-quartet","headword":"quartet","cefr":"C1","sourceCollection":"extended","sourceOrder":4670,"sourceEntry":"quartet n.","senses":[{"id":"gen-b3-quartet-n","partOfSpeech":"n.","turkishMeanings":["dörtlü","kuartet"],"examples":[{"en":"The quartet played Mozart.","tr":"Dörtlü Mozart çaldı."},{"en":"A string quartet 