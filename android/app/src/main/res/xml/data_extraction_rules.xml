<?xml version="1.0" encoding="utf-8"?>
<!--
  Kullanıcının verisi Google yedeğine dahildir.

  NEDEN DEĞİŞTİ. Bu dosya önceden her şeyi hariç tutuyordu ve gerekçesi
  şuydu: WebView deposunda oturum jetonu duruyor, cihaz dışına çıkarsa
  telefona kısa süre erişen biri hesabı ele geçirebilir.

  O gerekçe bu dağıtımda geçerli değil. Sunucusuz sürümde hesap yok, oturum
  jetonu yok; depoda yalnızca kullanıcının kendi kelimeleri, setleri ve
  ilerlemesi var. Yani korunacak sır kalmadı, kaybedilecek emek kaldı.

  Yedek kapalıyken telefonunu değiştiren ya da kaybeden kullanıcı aylarca
  biriktirdiği setleri geri getiremiyordu — elle JSON yedeği almayı akıl
  etmişse başka. Etmeyenler için sessiz bir veri kaybıydı. Açık yedekle
  aynı Google hesabıyla kurulan yeni telefona veri kendiliğinden geliyor.

  DİKKAT: Sunucu ve hesap sistemi ileride açılırsa bu karar yeniden
  düşünülmeli. O gün depoda yeniden oturum jetonu olacak; en azından
  jetonun tutulduğu anahtar yedekten çıkarılmalı.
-->
<data-extraction-rules>
    <!--
      İçerik belirtilmediğinde Android yedeklenebilir her şeyi dahil eder;
      uygulamanın `no_backup` dizini ile önbellek zaten kendiliğinden
      dışarıda kalır.
    -->
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
