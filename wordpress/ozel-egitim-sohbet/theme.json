{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "840px",
			"wideSize": "1340px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "ink",
					"name": "Koyu Yazı",
					"color": "#10312a"
				},
				{
					"slug": "body",
					"name": "Gövde Yazısı",
					"color": "#4b5f58"
				},
				{
					"slug": "muted",
					"name": "Soluk Yazı",
					"color": "#5e706a"
				},
				{
					"slug": "primary",
					"name": "Ana Yeşil",
					"color": "#1c6b58"
				},
				{
					"slug": "deep",
					"name": "Koyu Yeşil",
					"color": "#0c3229"
				},
				{
					"slug": "mint",
					"name": "Nane",
					"color": "#e7f2ec"
				},
				{
					"slug": "accent",
					"name": "Pirinç Vurgu",
					"color": "#a06a2c"
				},
				{
					"slug": "accent-soft",
					"name": "Açık Pirinç",
					"color": "#f6e7d2"
				},
				{
					"slug": "surface",
					"name": "Fildişi Zemin",
					"color": "#f7f4ed"
				},
				{
					"slug": "line",
					"name": "Çizgi",
					"color": "#e3e9e4"
				},
				{
					"slug": "white",
					"name": "Beyaz",
					"color": "#ffffff"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Gövde Yazısı",
					"fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif"
				},
				{
					"slug": "heading",
					"name": "Başlık Yazısı",
					"fontFamily": "Georgia, 'Times New Roman', 'Noto Serif', serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.82rem",
					"name": "Küçük"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Normal"
				},
				{
					"slug": "large",
					"size": "1.35rem",
					"name": "Büyük"
				},
				{
					"slug": "x-large",
					"size": "2.2rem",
					"name": "Çok Büyük"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"vw",
				"%"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.75rem",
					"name": "Dar"
				},
				{
					"slug": "40",
					"size": "1.5rem",
					"name": "Normal"
				},
				{
					"slug": "60",
					"size": "3rem",
					"name": "Geniş"
				},
				{
					"slug": "80",
					"size": "5rem",
					"name": "Çok Geniş"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "#f7f4ed",
			"text": "#4b5f58"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "16px",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "#10312a"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"lineHeight": "1.1",
					"letterSpacing": "-0.018em"
				}
			},
			"link": {
				"color": {
					"text": "#1c6b58"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "#0f4638"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"outline": {
						"color": "#1c6b58",
						"style": "solid",
						"width": "2px",
						"offset": "3px"
					}
				}
			},
			"button": {
				"border": {
					"radius": "10px"
				},
				"color": {
					"background": "#1c6b58",
					"text": "#ffffff"
				},
				"typography": {
					"fontWeight": "700"
				},
				"spacing": {
					"padding": {
						"top": "0.74rem",
						"bottom": "0.74rem",
						"left": "1.15rem",
						"right": "1.15rem"
					}
				},
				":hover": {
					"color": {
						"background": "#0f4638",
						"text": "#ffffff"
					}
				},
				":focus": {
					"color": {
						"background": "#0f4638",
						"text": "#ffffff"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"spacing": {
					"blockGap": "0.5rem"
				}
			},
			"core/separator": {
				"color": {
					"background": "#e3e9e4"
				}
			},
			"core/site-tagline": {
				"color": {
					"text": "#5e706a"
				},
				"typography": {
					"fontSize": "0.64rem"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Üst Menü",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Alt Bilgi",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-topluluk",
			"title": "Topluluk sayfası (tam genişlik)",
			"postTypes": [
				"page"
			]
		}
	]
}
