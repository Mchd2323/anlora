{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": { "contentSize": "840px", "wideSize": "1340px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "ink", "name": "Koyu Yazı", "color": "#163b33" },
				{ "slug": "muted", "name": "Soluk Yazı", "color": "#687a74" },
				{ "slug": "teal", "name": "Ana Turkuaz", "color": "#176b5b" },
				{ "slug": "deep", "name": "Koyu Turkuaz", "color": "#123f36" },
				{ "slug": "mint", "name": "Nane Yeşili", "color": "#dff1e9" },
				{ "slug": "peach", "name": "Şeftali", "color": "#f7d9c1" },
				{ "slug": "sand", "name": "Uyarı Sarısı", "color": "#fff8e9" },
				{ "slug": "cream", "name": "Krem", "color": "#faf8f1" },
				{ "slug": "line", "name": "Çizgi", "color": "#e0e6e1" },
				{ "slug": "white", "name": "Beyaz", "color": "#ffffff" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Gövde Yazısı",
					"fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif"
				},
				{
					"slug": "heading",
					"name": "Başlık Yazısı",
					"fontFamily": "Georgia, 'Times New Roman', 'Noto Serif', serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.82rem", "name": "Küçük" },
				{ "slug": "medium", "size": "1rem", "name": "Normal" },
				{ "slug": "large", "size": "1.35rem", "name": "Büyük" },
				{ "slug": "x-large", "size": "2.2rem", "name": "Çok Büyük" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "em", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "20", "size": "0.75rem", "name": "Dar" },
				{ "slug": "40", "size": "1.5rem", "name": "Normal" },
				{ "slug": "60", "size": "3rem", "name": "Geniş" },
				{ "slug": "80", "size": "5rem", "name": "Çok Geniş" }
			]
		}
	},
	"styles": {
		"color": { "background": "#faf8f1", "text": "#163b33" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "16px",
			"lineHeight": "1.55"
		},
		"elements": {
			"heading": {
				"color": { "text": "#163b33" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"lineHeight": "1.1"
				}
			},
			"link": {
				"color": { "text": "#176b5b" },
				"typography": { "textDecoration": "none" },
				":hover": { "color": { "text": "#123f36" }, "typography": { "textDecoration": "underline" } },
				":focus": { "outline": { "color": "#176b5b", "style": "solid", "width": "2px", "offset": "2px" } }
			},
			"button": {
				"border": { "radius": "10px" },
				"color": { "background": "#176b5b", "text": "#ffffff" },
				"typography": { "fontWeight": "700" },
				"spacing": { "padding": { "top": "0.72rem", "bottom": "0.72rem", "left": "1.1rem", "right": "1.1rem" } },
				":hover": { "color": { "background": "#123f36", "text": "#ffffff" } },
				":focus": { "color": { "background": "#123f36", "text": "#ffffff" } }
			}
		},
		"blocks": {
			"core/button": { "spacing": { "blockGap": "0.5rem" } },
			"core/separator": { "color": { "background": "#e0e6e1" } },
			"core/site-tagline": { "color": { "text": "#687a74" }, "typography": { "fontSize": "0.68rem" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Üst Menü", "area": "header" },
		{ "name": "footer", "title": "Alt Bilgi", "area": "footer" }
	],
	"customTemplates": [
		{
			"name": "page-topluluk",
			"title": "Topluluk sayfası (tam genişlik)",
			"postTypes": [ "page" ]
		}
	]
}
